	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	(SELECT concat(name, ' ',surname) FROM ~#~users WHERE ~#~attend.username = ~#~users.id) as user,
	dt as date, 
	dayname(dt) as dname,
	TIME(days) as startTime , 
	TIME(daye) as endTime, 
	TIMEDIFF(DAYE,DAYS) as hoursWorked,
	TIME_FORMAT(TIMEDIFF(C1e,C1s), '%H:%i') as e1,
	TIME_FORMAT(TIMEDIFF(C2e,C2s), '%H:%i') as E2,
	TIME_FORMAT(TIMEDIFF(C3e,C3s), '%H:%i') as E3,
	TIME_FORMAT(TIMEDIFF(C4e,C4s), '%H:%i') as E4,
	TIME_FORMAT(TIMEDIFF(C5e,C5s), '%H:%i') as E5,
	(select if(active='Yes',scat,null) from ~#~attendcat where num = '1') as h1,
	(select if(active='Yes',scat,null) from ~#~attendcat where num = '2') as h2,
	(select if(active='Yes',scat,null) from ~#~attendcat where num = '3') as h3,
	(select if(active='Yes',scat,null) from ~#~attendcat where num = '4') as h4,
	(select if(active='Yes',scat,null) from ~#~attendcat where num = '5') as h5,
	@ou:=timediff(TIMEDIFF(DAYE,DAYS),#HOURS WORKED LESS
		if(holiday='Yes',(select TIMEDIFF(tend, tstart) from ~#~attendcat where scat = 'Holiday'),
			if((dayname(dt)='Saturday' or dayname(dt) = 'Sunday'),
				(select TIMEDIFF(tend, tstart) from ~#~attendcat where scat = dayname(dt)), # ACTUAL HR SAT OR SUN 
				(select TIMEDIFF(tend, tstart) from ~#~attendcat where num = '1')) # ACTUAL HR WEEKDAYS
	)) as UnderO,
	if(@ou < '0',@ou,null) as Under,
	if(@ou < '0',null,@ou) as Over,
	if(@ou is null,'Absent','') as Absent
from ~#~attend 
where username like '~User~%' and date(dt) BETWEEN '~Date from~' and '~Date to~'
order by dt]]></queryString>

	<field name="user" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
	<field name="dname" class="java.lang.String"/>
	<field name="startTime" class="java.sql.Time"/>
