<jasperReport
		 name="GoodsReceivedNote"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 		~#~sttrans.code AS CODE, 
		~#~stockt2.descr AS DESCRIPTION, 
		abs(~#~sttrans.qty) AS QTY, 
		round(~#~sttrans.price,2)AS PRICE,
		~#~ctrans.ref as ref,
		round(~#~sttrans.price*abs(qty),2)as VALUE,
		round(sp1,2) as SP1,
		round((sp1-price)/price*100,0) as MU,
		round((sp1-price)/sp1*100,0) as GP,
		~#~stockt2.LstPurPrice1 as lstPrice,
		round((sp1-~#~stockt2.LstPurPrice1)/~#~stockt2.LstPurPrice1*100,0) as lstMU,
		round((sp1-~#~stockt2.LstPurPrice1)/sp1*100,0) as lstGP,
		~#~stockt2.skunum as barcode
from 		~#~sttrans, ~#~stockt2, ~#~ctrans 
where 		~#~sttrans.docnum = '~J~' 
and 		~#~sttrans.transtype = '6' 
and             ~#~sttrans.transtype = ~#~ctrans.transtype
and 		~#~sttrans.code = ~#~stockt2.code
and 		~#~sttrans.docnum = ~#~ctrans.docnum;]]></queryString>

