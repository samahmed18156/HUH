	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT	  code, descr, IFNULL((SELECT descr from ~#~departments WHERE num = dept),'') as DeptName, ROUND(cpe,2) AS CostExcl, ROUND(sp1,2) AS SellingIncl, soh, rqty, 
	  IFNULL((SELECT name FROM ~#~creditors WHERE accnum = suply ),'') AS SupplierName 
FROM 	  ~#~stockt2
WHERE 	  soh <= minQty
and dept like '~Dept~'
AND 	  rqty <> '0'
ORDER BY  SupplierName ASC, descr ASC;]]></queryString>

