	<field name="QtySold" class="java.lang.Double"/>
	<field name="AvgPrice" class="java.lang.Double"/>
	<field name="CostEx" class="java.lang.Double"/>
	<field name="Price" class="java.lang.Double"/>
	<field name="GP" class="java.lang.Double"/>
	<field name="MU" class="java.lang.Double"/>
	<field name="Profit" class="java.lang.Double"/>

	<variable name="SUM_QtySold_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{QtySold}]]></variableExpression>
	</variable>
	<variable name="SUM_CostEx_1" class="java.lang.Double" resetType="Report" calculation="Sum">
