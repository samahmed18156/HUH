<jasperReport
		 name="Stock Adj Debits"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 	~#~STTRANS.DATE, 
	~#~STTRANS.TIME, 
       	~#~STOCKT2.CODE, 
	~#~STOCKT2.DESCR,
	~#~STTRANS.QTY * ~#~STTRANS.PRICE AS VALUE, 
       	~#~STOCKT2.SOH, 
	~#~STTRANS.QTY as QTY_Added, ~#~STTRANS.USER,
	~#~STTRANS.descr AS Note,
	~#~sttrans.sohwh as Warehouse
FROM   	~#~STTRANS, ~#~STOCKT2
WHERE  	~#~STOCKT2.CODE = ~#~STTRANS.CODE 
AND    	~#~STTRANS.TRANSTYPE = '2' 
AND    	date BETWEEN '~Date from~' AND '~Date to~' and sohwh like '~Warehouse~']]></queryString>

	<field name="DATE" class="java.sql.Date"/>
	<field name="TIME" class="java.sql.Time"/>
	<field name="CODE" class="java.lang.String"/>
	<field name="DESCR" class="java.lang.String"/>
	<field name="SOH" class="java.lang.Integer"/>
	<field name="QTY_Added" class="java.lang.Integer"/>
	<field name="USER" class="java.lang.String"/>
	<field name="VALUE" class="java.lang.Double"/>
	<field name="Note" class="java.lang.String"/>
	<field name="Warehouse" class="java.lang.String"/>

	<variable name="SUM_QTY_Added_1" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{QTY_Added}]]></variableExpression>
	</variable>
	<variable name="SUM_SOH_1" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SOH}]]></variableExpression>
	</variable>
	<variable name="SUM_VALUE_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{VALUE}]]></variableExpression>
	</variable>
