	<queryString><![CDATA[select 
	date as sDate,
	time as sTime,
	docnum as DocNum,
	concat(code,' ',descr) as descr,
	round(qty,0) as Qty,
	round(price,2) as Price,
	user as sUser,
	(select dtype from doctype where num = transtype) as Trans
from ~#~sttrans where code like '~Code~|%' order by date, time]]></queryString>

