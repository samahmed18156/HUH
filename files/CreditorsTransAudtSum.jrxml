<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="CreditorsTransAudtSum"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="SUBREPORT_DIR" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
(SELECT name FROM codetails where coNum = '~#~') AS Name,
(SELECT IFNULL(ROUND(SUM(transam),2),0.0) FROM ~#~ctrans WHERE transtype = '6' AND paytype = '5' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotGRN,
(SELECT IFNULL(ROUND(SUM(vatAM),2),0.0) FROM ~#~ctrans WHERE transtype = '6' AND paytype = '5' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotGRNVat,
(SELECT IFNULL(ROUND(SUM(transam),2),0.0) FROM ~#~ctrans WHERE transtype = '7' AND paytype = '6' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotDisc,
(SELECT IFNULL(ROUND(SUM(vatAM),2),0.0) FROM ~#~ctrans WHERE transtype = '7' AND paytype = '6' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotDiscVat,
(SELECT IFNULL(ROUND(SUM(transam),2),0.0) FROM ~#~ctrans WHERE transtype = '2' AND paytype = '6' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotJrDr,
(SELECT IFNULL(ROUND(SUM(vatAM),2),0.0) FROM ~#~ctrans WHERE transtype = '2' AND paytype = '6' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotJrDrVat,
(SELECT IFNULL(ROUND(SUM(transam),2),0.0) FROM ~#~ctrans WHERE transtype = '3' AND paytype = '6' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotJrCr,
(SELECT IFNULL(ROUND(SUM(vatAM),2),0.0) FROM ~#~ctrans WHERE transtype = '3' AND paytype = '6' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotJrCrVat,
(SELECT IFNULL(ROUND(SUM(transam),2),0.0) FROM ~#~ctrans WHERE transtype = '9' AND paytype = '5' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS CrDrNotes,
(SELECT IFNULL(ROUND(SUM(vatAM),2),0.0) FROM ~#~ctrans WHERE transtype = '9' AND paytype = '5' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS CrDrNotesVat,
(SELECT IFNULL(ROUND(SUM(transam) * -1,2),0.0) FROM ~#~ctrans WHERE transtype = '5' AND paytype = '1' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS CrPaymentsCash,
(SELECT IFNULL(ROUND(SUM(transam) * -1,2),0.0) FROM ~#~ctrans WHERE transtype = '5' AND paytype = '2' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS CrPaymentsCheque,
(SELECT IFNULL(ROUND(SUM(transam) * -1,2),0.0) FROM ~#~ctrans WHERE transtype = '5' AND paytype = '3' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS CrPaymentsCCard,
(SELECT IFNULL(ROUND(SUM(transam) * -1,2),0.0) FROM ~#~ctrans WHERE transtype = '5' AND paytype = '8' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS CrPaymentsTransfer,
(SELECT IFNULL(ROUND(SUM(transam),2),0.0) FROM ~#~ctrans WHERE transtype = 'E' AND paytype = '5' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotExp,
(SELECT IFNULL(ROUND(SUM(vatAM),2),0.0) FROM ~#~ctrans WHERE transtype = 'E' AND paytype = '5' AND DATE BETWEEN  '~Date from~' AND '~Date to~') AS TotExpVat
FROM dual;]]></queryString>

	<field name="TotGRN" class="java.lang.Double"/>
	<field name="TotGRNVat" class="java.lang.Double"/>
	<field name="CrDrNotes" class="java.lang.Double"/>
	<field name="CrDrNotesVat" class="java.lang.Double"/>
	<field name="CrPaymentsCash" class="java.lang.Double"/>
	<field name="CrPaymentsCheque" class="java.lang.Double"/>
	<field name="CrPaymentsCCard" class="java.lang.Double"/>
	<field name="CrPaymentsTransfer" class="java.lang.Double"/>
	<field name="Name" class="java.lang.String"/>
	<field name="TotDisc" class="java.lang.Double"/>
	<field name="TotDiscVat" class="java.lang.Double"/>
	<field name="TotJrDr" class="java.lang.Double"/>
	<field name="TotJrDrVat" class="java.lang.Double"/>
	<field name="TotJrCr" class="java.lang.Double"/>
	<field name="TotJrCrVat" class="java.lang.Double"/>
	<field name="TotExp" class="java.lang.Double"/>
	<field name="TotExpVat" class="java.lang.Double"/>

	<variable name="TotPayments" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{CrPaymentsCash}.doubleValue()) +($F{CrPaymentsCheque}.doubleValue()) +($F{CrPaymentsCCard}.doubleValue()) +($F{CrPaymentsTransfer}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="SUM_CrPaymentsCash_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CrPaymentsCash}]]></variableExpression>
	</variable>
	<variable name="SUM_CrPaymentsCheque_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CrPaymentsCheque}]]></variableExpression>
	</variable>
	<variable name="SUM_CrPaymentsCCard_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CrPaymentsCCard}]]></variableExpression>
	</variable>
	<variable name="SUM_CrPaymentsTransfer_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CrPaymentsTransfer}]]></variableExpression>
	</variable>
	<variable name="SUM_TotGRN_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{TotGRN}]]></variableExpression>
	</variable>
	<variable name="SUM_CrDrNotes_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CrDrNotes}]]></variableExpression>
	</variable>
	<variable name="TotAccount" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotGRN}.doubleValue()) +($F{CrDrNotes}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="Total" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double( ($V{SUM_TotGRN_1}.doubleValue()) +($V{SUM_CrDrNotes_1}.doubleValue()) + ($V{TotPayments}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="TotVat" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotGRNVat}.doubleValue()) +($F{CrDrNotesVat}.doubleValue()) +($F{TotDiscVat}.doubleValue()) +($F{TotJrDrVat}.doubleValue()) +($F{TotJrCrVat}.doubleValue()) + ($F{TotExpVat}.doubleValue()) )]]></variableExpression>
	</variable>
