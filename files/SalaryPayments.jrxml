	<queryString><![CDATA[select t.userid, concat(e.firstnames,' ',e.surname) as name, t.nett, t.uif+t.uifEmp as UIF, t.tax as PAYE, trim(replace(e.paytype,'- ?','')) as pay  from m1attendtrans  as t
INNER JOIN m1attendempmast e ON t.userid = e.userid
where date between '2018-03-01' and '2018-03-30'
order by pay]]></queryString>

