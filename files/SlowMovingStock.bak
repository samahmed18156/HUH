	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		code, descr, dept, mdate AS DateLastSold, soh, ROUND(cpe,2) As CostExcl, ROUND(sp1,2) AS SellingExcl  
FROM 		~#~stockt2 
WHERE 		mdate <= '~Date last sold~' 
AND created <= '~Date last sold~' 
AND		soh > '0' 
AND dept like '%~Dept~' 
ORDER BY 	soh DESC 
LIMIT 		0, ~Quantity~;]]></queryString>

	<field name="code" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="dept" class="java.lang.String"/>
	<field name="DateLastSold" class="java.sql.Timestamp"/>
	<field name="soh" class="java.lang.Double"/>
	<field name="CostExcl" class="java.lang.Double"/>
	<field name="SellingExcl" class="java.lang.Double"/>

	<variable name="SUM_soh_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{soh}]]></variableExpression>
	</variable>
	<variable name="SUM_CostExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CostExcl}]]></variableExpression>
	</variable>
	<variable name="SUM_SellingExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SellingExcl}]]></variableExpression>
	</variable>
