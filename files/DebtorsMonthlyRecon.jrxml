	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	ACCNUM as accnum, 
	(select name from ~#~debtors where ~#~debtors.accnum = ~#~dtrans.accnum)as name, 
	ROUND((SELECT OSBAL FROM ~#~DEBTORS WHERE ~#~DEBTORS.ACCNUM = ~#~DTRANS.ACCNUM),0) AS DBT_OS, 
	ROUND(SUM(TRANSAM)+ (SELECT BALBF FROM ~#~DEBTORS WHERE ~#~DEBTORS.ACCNUM = ~#~DTRANS.ACCNUM),0) AS CURRENT 
FROM ~#~DTRANS 
WHERE !(TRANSTYPE = '0' AND PAYTYPE IN ('1','2','3','8')) AND !(TRANSTYPE = '8' AND PAYTYPE IN ('1','2','3','8'))  and !(transtype = '7' and agent != '-')
AND concat(DATE,' ',time) > (select max(date) from ~#~monthenddebtors)
GROUP BY ACCNUM
HAVING DBT_OS != CURRENT]]></queryString>

	<field name="accnum" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="DBT_OS" class="java.lang.Double"/>
	<field name="CURRENT" class="java.lang.Double"/>

