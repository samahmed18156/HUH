	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	~#~sttrans.code as Code, 
	~#~stockt2.descr as Description, 
	~#~sttrans.qty*-1 as Qty, 
	~#~sttrans.accnum as AccNum, 
	(select name from ~#~debtors where AccNum=~#~sttrans.accnum )as AccName, 
	(select lstpd from ~#~debtors where AccNum=~#~sttrans.accnum) as LastTrans
from ~#~sttrans, ~#~stockt2 
where accnum in (select accnum from ~#~debtors where laybye = '1' and osbal > '0') and ~#~stockt2.code = ~#~sttrans.code;]]></queryString>

