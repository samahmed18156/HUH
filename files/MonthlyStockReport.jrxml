<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="RMonthlyStockReport"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	@Stock_type := stktype AS Stock_type, 
	IFNULL((SELECT ROUND(ClosingValueExcl,2) FROM monthlystock WHERE date = DATE_SUB('~Date from~',INTERVAL 1 DAY) AND stktype = @Stock_type),(IFNULL((SELECT ROUND(ClosingValueExcl,2) from monthlystock where date = DATE_SUB('~Date from~',INTERVAL 2 DAY)and stktype = @Stock_type),(IFNULL((SELECT ROUND(ClosingValueExcl,2) from monthlystock where date = DATE_SUB('~Date from~',INTERVAL 3 DAY)and stktype = @Stock_type),0.00))))) AS OpeningValueExcl,
	IFNULL(ROUND(SUM(PurchaseValExcl),2),0.00) As PurchasesExcl,
	IFNULL(ROUND(SUM(ValueSoldExcl),2),0.00) AS SalesExcl,
	IFNULL((SELECT ROUND(SUM(ValueSoldExcl),2) FROM monthlystock WHERE date BETWEEN '~Date from~' AND '~Date to~'),0.00) AS Tot_Sales,
	IFNULL(ROUND(SUM(CostSoldExcl),2),0.00) AS Cost_of_Sales_Excl,
	IFNULL((SELECT ClosingValueExcl FROM monthlystock WHERE DATE = '~Date to~' AND stktype =  @Stock_type),0.00) AS ClosingValueExcl
FROM 		monthlystock	
WHERE		date BETWEEN '~Date from~' AND '~Date to~' 
GROUP BY 	Stock_type
ORDER BY 	Stock_type ASC;]]></queryString>

	<field name="Stock_type" class="java.lang.String"/>
	<field name="OpeningValueExcl" class="java.lang.Double"/>
	<field name="PurchasesExcl" class="java.lang.Double"/>
	<field name="SalesExcl" class="java.lang.Double"/>
	<field name="Tot_Sales" class="java.lang.Double"/>
	<field name="Cost_of_Sales_Excl" class="java.lang.Double"/>
	<field name="ClosingValueExcl" class="java.lang.Double"/>

	<variable name="Gp" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  (($F{SalesExcl}.doubleValue()) -($F{Cost_of_Sales_Excl}.doubleValue())) / ($F{SalesExcl}.doubleValue()) * 100 )]]></variableExpression>
	</variable>
	<variable name="PercContribution" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{SalesExcl}.doubleValue()) /($F{Tot_Sales}.doubleValue()) * 100 )]]></variableExpression>
	</variable>
	<variable name="AvgStk" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(($F{Cost_of_Sales_Excl}.doubleValue()) / ((($F{OpeningValueExcl}.doubleValue())+($F{ClosingValueExcl}.doubleValue())) / 2) *12)
]]></variableExpression>
	</variable>
	<variable name="SUM_PurchasesExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{PurchasesExcl}]]></variableExpression>
	</variable>
	<variable name="SUM_SalesExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SalesExcl}]]></variableExpression>
	</variable>
	<variable name="SUM_Cost_of_Sales_Excl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost_of_Sales_Excl}]]></variableExpression>
	</variable>
	<variable name="TotGP" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double( (($V{SUM_SalesExcl_1}.doubleValue()) -($V{SUM_Cost_of_Sales_Excl_1}.doubleValue())) / ($V{SUM_SalesExcl_1}.doubleValue()) * 100)]]></variableExpression>
	</variable>
