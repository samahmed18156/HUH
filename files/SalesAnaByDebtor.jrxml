	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 	date,
	accnum,
	(select name from ~#~debtors where ~#~sttrans.accnum = ~#~debtors.accnum) as name,
	docnum,
	~#~sttrans.code as Code, 
	~#~stockt2.descr as Description, 
	(~#~sttrans.QTY)*-1 as Qty,  
	~#~sttrans.itmnum as item,
	round((~#~sttrans.price*~#~sttrans.qty*-1),2) as iValue, 
	~#~sttrans.sohwh as Warehouse,
	(select dtype from doctype where ~#~sttrans.transtype = doctype.num) as type
FROM ~#~sttrans, ~#~stockt2 
WHERE 	~#~sttrans.date BETWEEN '~Date from~' AND '~Date to~' and 
	~#~sttrans.code = ~#~stockt2.code  
	and (~#~sttrans.transtype = '0' or ~#~sttrans.transtype = '8' or ~#~sttrans.transtype = '4')
	and accnum like '~accnum~'
Order by name, date, docnum,item asc;]]></queryString>

