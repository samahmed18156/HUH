	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT		~#~stocktake.code AS Stk_code,
		~#~stockt2.descr AS Stk_descr,
		ROUND(~#~stockt2.cpe,2) AS Cost_excl,
		(SELECT descr FROM ~#~departments where num = ~#~stockt2.dept) AS Stk_dept,
		ROUND(~#~stockt2.soh,2) As SOH,
		ROUND(~#~stocktake.qty,2) AS Counted
FROM 		~#~stocktake, ~#~stockt2
WHERE 		~#~stocktake.Code = ~#~stockt2.code
AND 		~#~stocktake.Qty <> ~#~stockt2.soh
ORDER BY 	~#~stocktake.Code ASC, ~#~stockt2.descr ASC, Stk_dept ASC ]]></queryString>

	<field name="Stk_code" class="java.lang.String"/>
	<field name="Stk_descr" class="java.lang.String"/>
	<field name="Cost_excl" class="java.lang.Double"/>
	<field name="Stk_dept" class="java.lang.String"/>
	<field name="SOH" class="java.lang.Double"/>
	<field name="Counted" class="java.lang.Double"/>

	<variable name="variance" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Counted}.doubleValue()) -($F{SOH}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="varianceValue" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{variance}.doubleValue()) *($F{Cost_excl}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="SUM_varianceValue_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{varianceValue}]]></variableExpression>
	</variable>
