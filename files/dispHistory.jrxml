	<queryString><![CDATA[select 
	date as Date, 
	code as Code, 
	descr as Descr, 
	qty as Qty, 
	transType as TransType, 
	docNum as Docnum, 
	user as tUser, 
	note as Note,
	(@runtot := if(@lstCode=code,@runtot + qty,qty)) AS rt,
	(@lstCode := code) AS lcode
from ~#~dispatch where invNum = '~InvNum~' order by code, date]]></queryString>

