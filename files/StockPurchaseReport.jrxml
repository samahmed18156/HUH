	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		~#~stockt2.code AS Stk_code, 	
		~#~stockt2.descr AS Descr,
		~#~creditors.name AS Supplier_name,
		(SELECT qty FROM ~#~sttrans WHERE code = ~#~stockt2.code AND transtype = '6' ORDER BY date desc limit 1) AS Qty,
		(SELECT date FROM ~#~sttrans WHERE code = ~#~stockt2.code AND transtype = '6' ORDER BY date desc limit 1) AS Last_date_purchased
FROM 		~#~stockt2, ~#~creditors
WHERE		~#~stockt2.suply = ~#~creditors.accnum
AND		~#~stockt2.code BETWEEN '~Code from~' AND '~Code to~'
ORDER BY 	~#~stockt2.code]]></queryString>

	<field name="Stk_code" class="java.lang.String"/>
	<field name="Descr" class="java.lang.String"/>
	<field name="Supplier_name" class="java.lang.String"/>
	<field name="Qty" class="java.lang.Double"/>
	<field name="Last_date_purchased" class="java.sql.Date"/>

