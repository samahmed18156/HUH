	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 	s.code AS CODE, 
	s.descr AS DESCRIPTION, 
	s.qty*-1 AS QTY, 
	round(s.price,2)AS PRICE,
	round(s.price*-1*qty,2)as VALUE,
	st.dept 
	from ~#~sttrans as s, ~#~stockt2 as st
	where docnum = '~J~' 
	and transtype = '0'
	and dept = (SELECT num from ~#~departments where st.dept=~#~departments.NUM and st.code =s.code and ~#~departments.printer = '~e~')
and st.code =s.code;]]></queryString>

	<field name="CODE" class="java.lang.String"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="QTY" class="java.lang.Integer"/>
	<field name="PRICE" class="java.lang.Double"/>
	<field name="VALUE" class="java.lang.Double"/>

	<variable name="SUM_QTY_1" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{QTY}]]></variableExpression>
	</variable>
	<variable name="SUM_VALUE_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{VALUE}]]></variableExpression>
	</variable>
