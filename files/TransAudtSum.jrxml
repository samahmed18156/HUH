	<parameter name="SUBREPORT_DIR" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
	(select name from codetails where conum = '~#~') as name, 
	(select '~A~')as A,
	(select '~B~')as B,
	(select '~C~')as C,
	(select '~D~')as D,
	(select '~E~')as E,
	(select '~F~')as F,
	(select '~G~')as G,
	(select '~H~')as H,
	(select '~I~')as I,
	(select '~J~')as J,
	(select '~K~')as K,
	(select '~L~')as L,
	(select '~M~')as M,
	(select '~N~')as N,
	(select '~O~')as O,
	(select '~P~')as P,
	(select '~Q~')as Q,
	(select '~R~')as R,
	(select '~S~')as S,
	(select '~T~')as T,
	(select '~U~')as U,
	(select '~V~')as V,
	(select '~W~')as W,
	(select '~X~')as X,
	(select '~Y~')as Y,
	(select '~Z~')as Z,
	(select '~1~')as Cash, 
	(select '~2~') as Cheque, 
	(select '~3~') as Card, 
	(select '~4~') as Transfer, 
	(select '~5~') as Other, 
	(select '~9~')as v9,
	(select '~0~')as v0,
	(select '~a~')as aa,
	(select '~b~')as bb,
	(select '~c~')as cc,
	(select '~d~')as dd,
	(select '~e~')as ee,
	(select '~f~')as ff,
	(select '~g~')as gg,
ifnull((select replace(pvalue,';','\\') as val from m1properties where pname like 'chequeText'),'Cheque') as CheqTxt
from dual]]></queryString>

