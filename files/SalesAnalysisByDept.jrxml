<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="SalesAnalysisByDept"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	DESCR AS DeptNAME,

@COSTEX := IFNULL((SELECT ROUND(SUM(QTY*COST*-1),2) FROM ~#~sttrans WHERE 
	DATE  between '~Date from~' and '~Date to~'
	AND transtype in ('8','0','4')
	AND CODE IN (SELECT CODE FROM ~#~stockt2 WHERE DEPT = NUM)),0) AS COST,

@SALESEXVAT := IFNULL((SELECT ROUND(SUM(QTY*PRICE*-1)-SUM(qty*VAT*-1),2) FROM ~#~sttrans WHERE 
	DATE between '~Date from~' and '~Date to~'
	AND transtype in ('8','0','4')
	AND CODE IN (SELECT CODE FROM ~#~stockt2 WHERE DEPT = NUM)),0) AS SALESEXVAT,

IFNULL((SELECT ROUND(SUM(qty*VAT*-1),2) FROM ~#~sttrans WHERE 
	DATE  between '~Date from~' and '~Date to~'
	AND transtype in ('8','0','4')
	AND CODE IN (SELECT CODE FROM ~#~stockt2 WHERE DEPT = NUM)),0) AS VAT,

IFNULL((SELECT ROUND(SUM(QTY*PRICE*-1),2) FROM ~#~sttrans WHERE 
	DATE  between '~Date from~' and '~Date to~'
	AND transtype in ('8','0','4')
	AND CODE IN (SELECT CODE FROM ~#~stockt2 WHERE DEPT = NUM)),0) AS SALES,

@GP := @SALESEXVAT - @COSTEX AS GP,
IFNULL(ROUND(@GP / @SALESEXVAT*100,2),0) AS GPPEC
FROM ~#~departments;]]></queryString>

	<field name="DeptNAME" class="java.lang.String"/>
	<field name="COST" class="java.lang.Double"/>
	<field name="SALESEXVAT" class="java.lang.Double"/>
	<field name="VAT" class="java.lang.Double"/>
	<field name="SALES" class="java.lang.Double"/>
	<field name="GP" class="java.lang.Double"/>
	<field name="GPPEC" class="java.lang.Double"/>

	<variable name="SUM_COST_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{COST}]]></variableExpression>
	</variable>
	<variable name="SUM_SALESEXVAT_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SALESEXVAT}]]></variableExpression>
	</variable>
	<variable name="SUM_VAT_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{VAT}]]></variableExpression>
	</variable>
	<variable name="SUM_SALES_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SALES}]]></variableExpression>
	</variable>
	<variable name="SUM_GP_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{GP}]]></variableExpression>
	</variable>
	<variable name="SUM_GPPEC_1" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  (($V{SUM_GP_1}.doubleValue()) / ($V{SUM_SALESEXVAT_1}.doubleValue())*100 ))]]></variableExpression>
	</variable>
