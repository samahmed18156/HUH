	</variable>
	<variable name="SUM_GP_1" class="java.lang.Double" resetType="Report" calculation="Average">
		<variableExpression><![CDATA[$F{GP}]]></variableExpression>
	</variable>
	<variable name="SUM_MU_1" class="java.lang.Double" resetType="Report" calculation="Average">
		<variableExpression><![CDATA[$F{MU}]]></variableExpression>
	</variable>
	<variable name="SUM_QTY" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Qty}]]></variableExpression>
	</variable>
	<variable name="SUM_SOH" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SOH}]]></variableExpression>
	</variable>
