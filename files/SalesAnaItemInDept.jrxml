	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	~#~sttrans.code as Code, 
	~#~stockt2.descr as Description, 
	SUM(~#~sttrans.QTY)*-1 as Qty,  
	~#~stockt2.soh as SOH, 
	round(sum(~#~sttrans.price*~#~sttrans.qty*-1),2) as iValue, 
	round(sum(~#~sttrans.cost*~#~sttrans.qty*-1),2) as Cost, 
round(sum(~#~sttrans.price*~#~sttrans.qty*-1)-(select if(vattype = 'I',(sum(~#~sttrans.vat*~#~sttrans.qty*-1)),0) from codetails where conum = '~#~')-sum(~#~sttrans.cost*~#~sttrans.qty*-1),2) as Profit,
	ifnull(round((sum(~#~sttrans.price*~#~sttrans.qty*-1)-(select if(vattype = 'I',(sum(~#~sttrans.vat*~#~sttrans.qty*-1)),0) from codetails where conum = '~#~')-sum(~#~sttrans.cost*~#~sttrans.qty*-1))/(sum(~#~sttrans.price*~#~sttrans.qty*-1)-(select if(vattype = 'I',(sum(~#~sttrans.vat*~#~sttrans.qty*-1)),0) from codetails where conum = '~#~'))*100,0),0) as GP,
	ifnull(round((sum(~#~sttrans.price*~#~sttrans.qty*-1)-(select if(vattype = 'I',(sum(~#~sttrans.vat*~#~sttrans.qty*-1)),0) from codetails where conum = '~#~')-sum(~#~sttrans.cost*~#~sttrans.qty*-1))/(sum(~#~sttrans.cost*~#~sttrans.qty*-1))*100,0),0) as MU 
FROM ~#~sttrans, ~#~stockt2 
WHERE 	~#~sttrans.date BETWEEN '~Date from~' AND '~Date to~' and 
	dept = '~Dept~' and 
	~#~sttrans.code = ~#~stockt2.code  
	and (~#~sttrans.transtype = '0' or ~#~sttrans.transtype = '8' or ~#~sttrans.transtype = '4') 
GROUP BY code order by SUM(~#~sttrans.qty) asc;]]></queryString>

	<field name="Code" class="java.lang.String"/>
	<field name="Description" class="java.lang.String"/>
	<field name="Qty" class="java.lang.Double"/>
	<field name="SOH" class="java.lang.Double"/>
	<field name="iValue" class="java.lang.Double"/>
	<field name="Cost" class="java.lang.Double"/>
	<field name="Profit" class="java.lang.Double"/>
	<field name="GP" class="java.lang.Double"/>
	<field name="MU" class="java.lang.Double"/>

	<variable name="SUM_iValue_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{iValue}]]></variableExpression>
	</variable>
	<variable name="SUM_Cost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<variable name="SUM_Profit_1" class="java.lang.Double" resetType="Report" calculation="Sum">
