	<queryString><![CDATA[select date as tMonth, round(sum(transam),2) as tSales, count(*) as numSales from ~#~dtrans WHERE transtype in ('0','8') and date >  DATE_SUB(now(), INTERVAL 1 YEAR) group by month(date) order by date]]></queryString>

	<field name="tMonth" class="java.sql.Date"/>
	<field name="tSales" class="java.lang.Double"/>
	<field name="numSales" class="java.lang.Long"/>

