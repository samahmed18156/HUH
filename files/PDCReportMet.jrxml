	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT debtors.accnum, debtors.name, pdc.PDCNum, DATE(pdc.DueDate), DATE(pdc.Capture), pdc.Amount, pdc.Cheque
FROM ~#~debtors debtors, ~#~pdc pdc
WHERE debtors.accnum = pdc.AccNum
AND pdc.PDCMet like 'y%'
AND DATE(pdc.DueDate) BETWEEN '~Date from~' AND '~Date to~' 
ORDER BY DATE(pdc.DueDate);]]></queryString>

	<field name="accnum" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="PDCNum" class="java.lang.String"/>
	<field name="DATE(pdc.DueDate)" class="java.sql.Date"/>
	<field name="DATE(pdc.Capture)" class="java.sql.Date"/>
	<field name="Amount" class="java.lang.Double"/>
	<field name="Cheque" class="java.lang.String"/>

	<variable name="SUM_Amount_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Amount}]]></variableExpression>
	</variable>
	<variable name="SUM_Amount_2" class="java.lang.Double" resetType="Group" resetGroup="Test" calculation="Sum">
