<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="classic"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		~#~stockt2.code AS Stk_code, 
		~#~qtrans.descr As Descr,
		~#~qtrans.date as Inv_date, 
		~#~qtrans.qty  As Qty, 
		ROUND(~#~qtrans.price,2) As Unit_Sp, 
		ROUND(IF(~#~stockt2.vati = '0',~#~qtrans.cost, ~#~qtrans.cost + ~#~qtrans.cost * (SELECT VATRATE * 100 FROM CODETAILS WHERE CONUM = '~#~')/100),2)  AS Unit_Cost,
		~#~qtrans.accnum As Acc_num,
		(select name from ~#~debtors where accnum = ~#~qtrans.accnum) AS Acc_name
FROM 		~#~qtrans, ~#~stockt2 
WHERE 		~#~qtrans.docnum = '~Doc no~' 
AND 		~#~qtrans.code = ~#~stockt2.code]]></queryString>

	<field name="Stk_code" class="java.lang.String"/>
	<field name="Descr" class="java.lang.String"/>
	<field name="Inv_date" class="java.sql.Date"/>
	<field name="Qty" class="java.lang.Double"/>
	<field name="Unit_Sp" class="java.lang.Double"/>
	<field name="Unit_Cost" class="java.lang.Double"/>
	<field name="Acc_num" class="java.lang.String"/>
	<field name="Acc_name" class="java.lang.String"/>

	<variable name="tot_selling" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Qty}.doubleValue()) *($F{Unit_Sp}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="tot_cost" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Qty}.doubleValue()) *($F{Unit_Cost}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="profit" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{tot_selling}.doubleValue()) -($V{tot_cost}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="gp" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  (($V{tot_selling}.doubleValue()) -($V{tot_cost}.doubleValue())) / ($V{tot_selling}.doubleValue()) * 100)]]></variableExpression>
	</variable>
	<variable name="SUM_Unit_Sp_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Unit_Sp}]]></variableExpression>
	</variable>
	<variable name="SUM_Unit_Cost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Unit_Cost}]]></variableExpression>
	</variable>
	<variable name="SUM_tot_selling_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{tot_selling}]]></variableExpression>
	</variable>
	<variable name="SUM_tot_cost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{tot_cost}]]></variableExpression>
	</variable>
	<variable name="SUM_profit_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{profit}]]></variableExpression>
	</variable>
	<variable name="tot_gp" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  (($V{SUM_tot_selling_1}.doubleValue()) -($V{SUM_tot_cost_1}.doubleValue())) / ($V{SUM_tot_selling_1}.doubleValue()) * 100)]]></variableExpression>
	</variable>
