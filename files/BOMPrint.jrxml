	<queryString><![CDATA[select 	(select descr from ~#~stockt2 where code = '~B~') as mainItem,
	'~B~' as mainCode,
	'~C~' as QtyBuild,
	'~D~' as ref,
	l.link as code,
	s.descr as Descr,
	round(s.soh,2) as soh,
	l.qty,
	(l.qty*'~C~')as qtyreq
from ~#~stockt2 as s, ~#~links as l 
where l.code = '~B~'
and s.code = l.link
group by l.link;]]></queryString>

