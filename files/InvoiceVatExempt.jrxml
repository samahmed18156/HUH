	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select date,
	sum((qty*-1)*price) as TotalSales,
	sum(qty*-1*vat) as TotalVat,
	ifnull((select sum(qty*-1*price) from ~#~sttrans where date = t.date and transtype in ('0','8','4') and vat != '0'),0) as Vattable,
	ifnull((select sum(qty*-1*price) from ~#~sttrans where date = t.date  and transtype in ('0','8','4') and vat = '0'),0) as Exampt
from ~#~sttrans as t where date between '~Date from~' and '~Date to~' and transtype in ('0','8','4')
group by date;]]></queryString>

	<field name="date" class="java.sql.Date"/>
	<field name="TotalSales" class="java.lang.Double"/>
	<field name="TotalVat" class="java.lang.Double"/>
	<field name="Vattable" class="java.lang.Double"/>
	<field name="Exampt" class="java.lang.Double"/>

	<variable name="TS" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{TotalSales}]]></variableExpression>
	</variable>
	<variable name="TV" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{TotalVat}]]></variableExpression>
	</variable>
	<variable name="TB" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Vattable}]]></variableExpression>
	</variable>
	<variable name="TE" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Exampt}]]></variableExpression>
	</variable>
