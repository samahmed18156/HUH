	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		agent as agent,
	(SELECT dtype FROM doctype WHERE num = ~#~dtrans.transtype) AS DOCTYPE,
	sum(if(~#~dtrans.transtype = '4' and paytype != '5', ROUND((~#~dtrans.transAm*-1),2), ROUND((~#~dtrans.transAm),2))) AS TransAmnt, 
	sum(~#~dtrans.vatam) as vatAm,
	if(~#~dtrans.transtype = '7' ,(SELECT ROUND(AVG(comm),2) FROM ~#~sttrans WHERE docnum = ~#~dtrans.ref),IFNULL((SELECT ROUND(AVG(comm),2) FROM ~#~sttrans WHERE docnum = ~#~dtrans.docnum AND transtype = ~#~dtrans.transtype),'0.00')) as CommPec,
	sum(if(~#~dtrans.transtype = '7' ,round((~#~dtrans.transam-~#~dtrans.vatam)*(SELECT AVG(comm/100) FROM ~#~sttrans WHERE docnum = ~#~dtrans.ref),2), if(~#~dtrans.transtype = '8',round((~#~dtrans.transam-(~#~dtrans.vatam))*(SELECT AVG(comm/100) FROM ~#~sttrans WHERE docnum = ~#~dtrans.docnum),2),round((~#~dtrans.transam-~#~dtrans.vatam)*(SELECT AVG(comm/100) FROM ~#~sttrans WHERE docnum = ~#~dtrans.docnum)*(if(~#~dtrans.transtype = '4' and paytype != '5',-1,1)),2)))) AS COMM
FROM 	~#~dtrans
WHERE 	transtype IN ('0','8','4') 
AND 	DATE BETWEEN '~Date from~' AND '~Date to~'
group by agent, doctype
order by agent]]></queryString>

