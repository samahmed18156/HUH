	</variable>
	<variable name="SUM_sum(m1dtrans.vatam)_1" class="java.lang.Double" resetType="Group" resetGroup="AgentTotal" calculation="Sum">
		<variableExpression><![CDATA[$F{vatAm}]]></variableExpression>
	</variable>
	<variable name="SUM_COMM_1" class="java.lang.Double" resetType="Group" resetGroup="AgentTotal" calculation="Sum">
		<variableExpression><![CDATA[$F{COMM}]]></variableExpression>
	</variable>

