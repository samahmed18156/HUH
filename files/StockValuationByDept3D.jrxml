		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<subDataset name="SubDataset1" >

		<queryString><![CDATA[select sum(soh), dept, round(sum(((sp1  / 1.14) *soh)),2)as Selling
from ~#~stockt2 group by dept]]></queryString>

		<field name="sum(soh)" class="java.lang.Double"/>
		<field name="dept" class="java.lang.String"/>
		<field name="Selling" class="java.lang.Double"/>

	</subDataset>

	<queryString><![CDATA[SELECT 		stockt2.dept, IFNULL((SELECT descr from ~#~departments where num = dept),'') AS DepartmentName, 
		sum(stockt2.soh), round(sum(stockt2.cpe*stockt2.soh),2) as Cost, 
		round(sum(stockt2.acp*stockt2.soh),2) as AvgCost, 
		round(sum(((stockt2.sp1  / 1.14) * stockt2.soh)),2)as Selling 
FROM 		~#~stockt2 as stockt2
WHERE 		soh > 0 
GROUP BY 	dept
ORDER BY 	dept ASC;]]></queryString>

	<field name="dept" class="java.lang.String"/>
	<field name="DepartmentName" class="java.lang.String"/>
	<field name="sum(stockt2.soh)" class="java.lang.Double"/>
	<field name="Cost" class="java.lang.Double"/>
	<field name="AvgCost" class="java.lang.Double"/>
	<field name="Selling" class="java.lang.Double"/>

	<variable name="SUM_Cost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<variable name="SUM_Selling_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Selling}]]></variableExpression>
	</variable>
	<variable name="SUM_AvgCost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{AvgCost}]]></variableExpression>
	</variable>
	<variable name="SUM_sum(stockt2.soh)_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{sum(stockt2.soh)}]]></variableExpression>
	</variable>
