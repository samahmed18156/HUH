	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT (select descr from ~#~departments where num = s.dept) as dept, 
	DATE_FORMAT(t.date, '%m-%Y') as my, ROUND(SUM(t.QTY*t.PRICE*-1)-SUM(t.qty*t.VAT*-1),2) as amt
FROM ~#~sttrans t, ~#~stockt2 as s WHERE 
t.DATE between '~Date from~' and '~Date to~'
AND t.transtype in ('8','0','4') and s.code = t.code
group by s.dept, year(t.date), month(t.date)
order by t.date]]></queryString>

	<field name="dept" class="java.lang.String"/>
	<field name="my" class="java.lang.String"/>
	<field name="amt" class="java.lang.Double"/>

