	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		
	~#~stockt2.code as code, 
	descr, 
	soh as soh,
#	@other:=ifnull(qoh,0) as other,
	@other:=ifnull((select qoh from ~#~qoh where ~#~stockt2.code = ~#~qoh.code and qoh > '0'),0) as other,

	ROUND(cpe,2) AS UnitCostExcl, 
	ROUND(((soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0))*cpe),2) as CostExcl, 

	ROUND(cpi,2) AS UnitCostIncl, 
	ROUND(((soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0))*cpi),2) as CostIncl, 
		
	ROUND(SP1,2) AS UnitSellingIncl, 
	ROUND(((soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0))*sp1),2) as SellingIncl
FROM ~#~stockt2 
HAVING	soh > '0' or other > '0'
ORDER BY descr desc;]]></queryString>

	<field name="code" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="soh" class="java.lang.Double"/>
	<field name="other" class="java.lang.Double"/>
	<field name="UnitCostExcl" class="java.lang.Double"/>
	<field name="CostExcl" class="java.lang.Double"/>
	<field name="UnitCostIncl" class="java.lang.Double"/>
	<field name="CostIncl" class="java.lang.Double"/>
	<field name="UnitSellingIncl" class="java.lang.Double"/>
	<field name="SellingIncl" class="java.lang.Double"/>

	<variable name="SUM_CostExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CostExcl}]]></variableExpression>
	</variable>
	<variable name="SUM_SellingIncl _1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SellingIncl}]]></variableExpression>
	</variable>
	<variable name="SUM_ROUND(soh,2)_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{soh}]]></variableExpression>
	</variable>
	<variable name="SUM_UnitCostExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{UnitCostExcl}]]></variableExpression>
	</variable>
	<variable name="SUM_UnitSellingIncl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{UnitSellingIncl}]]></variableExpression>
	</variable>
	<variable name="SUM_CostIncl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CostIncl}]]></variableExpression>
	</variable>
	<variable name="SUM_other" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{other}]]></variableExpression>
	</variable>
