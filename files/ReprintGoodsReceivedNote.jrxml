	<queryString><![CDATA[select ~#~sttrans.code AS CODE, ~#~stockt2.descr AS DESCRIPTION, abs(~#~sttrans.qty) AS QTY, round(~#~sttrans.price,2)AS PRICE,round(~#~sttrans.price*abs(qty),2)as VALUE
