<jasperReport
		 name="StockMasterByType"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 'SALES' as DESCR ,round(sum(if(transtype='4' and paytype!='5',((transam*-1)-(vatam*-1)) ,transam-vatam)),2) as Dr ,null as Cr from ~#~dtrans where transtype in ('0','8','4') and date between '~Date from~' and '~Date to~'
union
select 'LESS COST OF SALES',round(sum(if(transtype='4' and paytype!='5',((transam*-1)-(vatam*-1)),transam-vatam))-sum(profit),2),null from ~#~dtrans where transtype in ('0','8','4') and date between '~Date from~' and '~Date to~'
union
select 'PROFIT',null,round(sum(profit),2) from ~#~dtrans where transtype in ('0','8','4') and date between '~Date from~' and '~Date to~'
union
select 'LESS EXPENSES',null,sum(transam-vatam)*-1 from ~#~ctrans where transType in ('E','X') and accnum in (select accnum from ~#~creditors where ctype = 'expense') and date between '~Date from~' and '~Date to~'
union
select   (select exdesc from ~#~exparam where code = (ifnull(substring(expcode,1,if(instr(expcode,' : ') = 0,length(expcode),instr(expcode,' : '))),'123'))) as name, round(sum(transam-vatam),2),null as tvalue
from ~#~ctrans 
where transType in ('X','E') 
and date between '~Date from~' and '~Date to~'
group by name;]]></queryString>

	<field name="DESCR" class="java.lang.String"/>
	<field name="Dr" class="java.lang.Double"/>
	<field name="Cr" class="java.lang.Double"/>

