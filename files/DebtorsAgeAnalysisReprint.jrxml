	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select
accnum, 
	(select name from ~#~debtors where accnum = ~#~monthenddebtors.accnum)as name,
	(select contact from ~#~debtors where accnum = ~#~monthenddebtors.accnum) As Contact,
	(select tel1 from ~#~debtors where accnum = ~#~monthenddebtors.accnum) As Tel,
	currbal, 
	d30,
	d60,
	d90,
	round(d120+d150+d180+d210+d240+d270+d300+d330,2) AS "120Days+", 
	round(currbal+d30+d60+d90+d120+d150+d180+d210+d240+d270+d300+d330,2) AS "O/S Balance",
	round(pdcbal,2) as pdcbal
FROM ~#~monthenddebtors where date(date) = '~Date~']]></queryString>

