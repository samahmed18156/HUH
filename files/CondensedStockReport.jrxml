<jasperReport
		 name="classic"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 		~#~stockt2.dept AS Dept_no,
		(SELECT descr from ~#~departments where Num = ~#~stockt2.dept) AS Name,
		sum(~#~stockt2.soh) AS SOH,
		round(( sum(~#~stockt2.soh) / (select sum(soh) from ~#~stockt2 where dept between '~Dept from~' and '~Dept to~' ))*100,2) AS Perc_of_stock,
		round(sum(~#~stockt2.valmtd),2) as SalesValMTD,
		round(( sum(~#~stockt2.valmtd) / (select sum(valmtd) from ~#~stockt2 where dept between '~Dept from~' and '~Dept to~' ))*100,2) AS Perc_of_sales,
		round(((sum(~#~stockt2.valmtd) - (select sum((~#~sttrans.qty * ~#~sttrans.cost) * -1) + sum(((~#~sttrans.qty * ~#~sttrans.cost) * -1) * 0.14)  from ~#~sttrans,~#~stockt2 where ~#~sttrans.transtype in ('0','8') and month(~#~sttrans.date) = month(now()) and ~#~stockt2.code = ~#~sttrans.code and ~#~stockt2.dept = Dept_no)) / (sum(~#~stockt2.valmtd))) * 100,2)  AS Gp
from 		~#~stockt2
where		~#~stockt2.dept between '~Dept from~' and '~Dept to~'
group by 	~#~stockt2.dept]]></queryString>

	<field name="Dept_no" class="java.lang.String"/>
	<field name="Name" class="java.lang.String"/>
	<field name="SOH" class="java.lang.Double"/>
	<field name="Perc_of_stock" class="java.lang.Double"/>
	<field name="SalesValMTD" class="java.lang.Double"/>
	<field name="Perc_of_sales" class="java.lang.Double"/>
	<field name="Gp" class="java.lang.Double"/>

	<variable name="SUM_SOH_1" class="java.lang.Double" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{SOH}]]></variableExpression>
	</variable>
	<variable name="SUM_SalesValMTD_1" class="java.lang.Double" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{SalesValMTD}]]></variableExpression>
	</variable>
