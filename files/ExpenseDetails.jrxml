	<queryString><![CDATA[select date, accnum, (select name from m1creditors c where c.accnum = t.accnum) as name, 
docnum, transAm, vatAm, user, ref, infNum from m1ctrans t 
where expcode = '~Expense~' and date between '~Date from~' and '~Date to~']]></queryString>

