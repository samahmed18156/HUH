	<queryString><![CDATA[SELECT code, descr, ROUND(soh,2),ROUND((~SP~),2) As SellingIncl 
FROM ~#~stockt2 
WHERE soh > ~SOH>~ 
AND ~Range~ BETWEEN '~From~' AND '~To~' 
ORDER BY ~Range~ ASC;]]></queryString>

