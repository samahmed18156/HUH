	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	date AS DATE, 
	time AS TIME, 
	(SELECT DTYPE FROM doctype WHERE NUM = transtype) as TYPE, 
	t.accnum AS ACCNUM, 
	c.name as CName,
	t.docnum AS DOCNUM, 
	round(abs(t.transAm-t.vatam),2) AS AMOUNTEx, 
	round(abs(t.transAm),2) AS AMOUNT, 
	round(t.vatAm,2) AS VAT, 
	(SELECT PTYPE FROM paytype WHERE NUM = t.paytype) as PAY, 
	t.user AS USER,
	t.ref as Refnum
FROM ~#~ctrans as t, ~#~creditors as c
where date BETWEEN '~Date from~' AND '~Date to~'
and t.accnum = c.accnum
and c.ctype = '~Type~'
ORDER BY date ASC;]]></queryString>

	<field name="AMOUNTEx" class="java.lang.Double"/>
	<field name="AMOUNT" class="java.lang.Double"/>
	<field name="VAT" class="java.lang.Double"/>
	<field name="TYPE" class="java.lang.String"/>
	<field name="ACCNUM" class="java.lang.String"/>
	<field name="CName" class="java.lang.String"/>
	<field name="DOCNUM" class="java.lang.String"/>
	<field name="PAY" class="java.lang.String"/>
	<field name="USER" class="java.lang.String"/>
	<field name="Refnum" class="java.lang.String"/>
	<field name="DATE" class="java.sql.Date"/>
	<field name="TIME" class="java.sql.Time"/>

	<variable name="SUM_AMOUNTEx_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{AMOUNTEx}]]></variableExpression>
	</variable>
	<variable name="SUM_VAT_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{VAT}]]></variableExpression>
	</variable>
	<variable name="SUM_AMOUNT_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
	</variable>
