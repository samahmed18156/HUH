	</variable>
	<variable name="totalCloseBlk" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{cblk}]]></variableExpression>
	</variable>
	<variable name="totalCloseSOH" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{csoh}]]></variableExpression>
	</variable>
	<variable name="stkCount" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{TotSales}.doubleValue()) - ($V{TotRShort}.doubleValue()) )]]></variableExpression>
	</variable>

