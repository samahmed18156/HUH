	<queryString><![CDATA[select 
	date as date, 
	code as code,
	(select descr from m1stockt2 where m1stockt2.code = m1stockcount.code) as descr, 
	Oblk, 
	OSOH, 
	GRN, 
	BakeFry, 
	ifnull(Damage,0) as Damage, 
	other, 
	ifnull(shortage,0) as shortage, 
	sold, 
	cblk, 
	csoh, 
	cntBlk, 
	cntSOH,
	lstSold,
	ifnull((select sp1 from m1stockt2 where m1stockt2.code = m1stockcount.code),0) as sp,
	(select descr from m1departments where num = (select dept from m1stockt2 where m1stockt2.code = m1stockcount.code)) as dept,
	ifnull(totalWait,if(lstReqest is not null,'12:00:00',null)) as waitTime
from m1stockcount where date = ~Date~
order by dept, code]]></queryString>

	<field name="date" class="java.sql.Date"/>
	<field name="code" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="Oblk" class="java.lang.Double"/>
	<field name="OSOH" class="java.lang.Double"/>
	<field name="GRN" class="java.lang.Double"/>
	<field name="BakeFry" class="java.lang.Double"/>
	<field name="Damage" class="java.lang.Double"/>
	<field name="other" class="java.lang.Double"/>
	<field name="shortage" class="java.lang.Double"/>
	<field name="sold" class="java.lang.Double"/>
	<field name="cblk" class="java.lang.Double"/>
	<field name="csoh" class="java.lang.Double"/>
	<field name="cntBlk" class="java.lang.Double"/>
	<field name="cntSOH" class="java.lang.Double"/>
	<field name="lstSold" class="java.sql.Timestamp"/>
	<field name="sp" class="java.lang.Double"/>
	<field name="dept" class="java.lang.String"/>
	<field name="waitTime" class="java.sql.Time"/>

	<variable name="TotDam" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Damage}]]></variableExpression>
	</variable>
	<variable name="TotShort" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{shortage}]]></variableExpression>
	</variable>
	<variable name="TotSales" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{sold}.doubleValue()) *($F{sp}.doubleValue()) *-1)]]></variableExpression>
	</variable>
	<variable name="TotRShort" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{shortage}.doubleValue()) *($F{sp}.doubleValue())*-1 )]]></variableExpression>
	</variable>
	<variable name="TransAm" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{sold}.doubleValue())*-1 *($F{sp}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="TotRDam" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Damage}.doubleValue()) *($F{sp}.doubleValue())*-1 )]]></variableExpression>
	</variable>
	<variable name="DeptTot" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$V{TransAm}]]></variableExpression>
		<initialValueExpression><![CDATA[$F{sp}]]></initialValueExpression>
	</variable>
	<variable name="totalQtySold" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{sold}]]></variableExpression>
	</variable>
	<variable name="totalOpenSoh" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{OSOH}]]></variableExpression>
	</variable>
	<variable name="totalOpenBlk" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
