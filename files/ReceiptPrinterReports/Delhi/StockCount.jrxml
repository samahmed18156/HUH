	</variable>
	<variable name="totalBakeFry" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{BakeFry}]]></variableExpression>
	</variable>
	<variable name="totalDamage" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{Damage}]]></variableExpression>
	</variable>
	<variable name="totalOther" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
		<variableExpression><![CDATA[$F{other}]]></variableExpression>
	</variable>
	<variable name="totalShortage" class="java.lang.Double" resetType="Group" resetGroup="Dept" calculation="Sum">
