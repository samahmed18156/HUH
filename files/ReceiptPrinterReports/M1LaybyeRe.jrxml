	<queryString><![CDATA[select 
	code AS CODE, 
	descr AS DESCRIPTION, 
	qty*-1 AS QTY, 
	round(price,2)AS PRICE, 
	round(price*-1*qty,2)as VALUE 
from ~#~sttrans as sttrans where docnum = '~J~' and transtype = '4';]]></queryString>

