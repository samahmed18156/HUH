	<queryString><![CDATA[select 
	code AS CODE, 
	descr AS DESCRIPTION, 
	qty AS QTY, 
	round(price,2)AS PRICE,
	round(price*qty,2)as VALUE, 
	(select loc from m1stockt2 s where s.code = sttrans.code) as loc 
from ~#~qtrans as sttrans where docnum = '~J~' and transtype = '0' having loc = 'CHM02';]]></queryString>

