	<queryString><![CDATA[select 
	if(docnum='-1','',date) as Date, 
	if(docnum='-1','',docnum) AS DocNo,
	ifnull((select dtype from doctype where num = transtype),'') as Description, 
	if(docnum='-1','',if(transam>='0',round(transam,2),'')) as Debit,
	if(transam<'0',round(transam*-1,2),'') as Credit,
	(SELECT concat('25th ',DATE_FORMAT('~Y~' + INTERVAL 1 MONTH,'%b %Y'))) AS FutureDate
from ~#~dtrans as dtrans where accnum = '~J~'
AND concat(date,' ',time) > (select lstMonthEnd from codetails where conum = '~#~')
AND ((Transtype = '7' and agent = '-') or (Transtype <> '7'));]]></queryString>

