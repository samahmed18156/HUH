	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	concat(date,' ',time) AS DATE,
	(SELECT DTYPE FROM doctype WHERE NUM = transtype) as TYPE, 
	accnum AS ACCNUM, 
	(select name from ~#~creditors where accnum = ~#~ctrans.accnum) as DName,
	docnum AS DOCNUM, 
	round((transAm-vatam),2) AS AMOUNTEx,  
	round(vatAm,2) AS VAT,
	round((transAm),2) AS AMOUNT,
	infNum as Refnum,
	user as user,
	(select ctype from ~#~creditors where accnum = ~#~ctrans.accnum) as ctype
FROM ~#~ctrans where date BETWEEN '~Date from~' AND '~Date to~'
And transtype in ('6','9','E','X')
having ctype = '~Type~'
ORDER BY DName,date ASC;]]></queryString>

