	<field name="Refnum" class="java.lang.String"/>
	<field name="user" class="java.lang.String"/>
	<field name="ctype" class="java.lang.String"/>

	<variable name="TAMTinc" class="java.lang.Double" resetType="Group" resetGroup="accnum" calculation="Sum">
