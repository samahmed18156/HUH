	<queryString><![CDATA[select 
	date,
	time, 
	code as STCode, 
	(select descr from ~#~stockt2 where code = STCode) as description,
	descr,
	resremark,
	qty, 
	price,
	(qty*price) as TotalAdjusted,
	docnum,
	(select dtype from doctype where num = transtype) as DocumentType,
	user,
	sohwh
from ~#~sttrans 
where 
	docnum in (~D~) and 
	transtype in ('2','3')]]></queryString>

