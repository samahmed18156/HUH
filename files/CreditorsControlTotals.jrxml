<jasperReport
		 name="CreditorsControlTotals"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT
(SELECT IFNULL( round(sum(transAm)-sum(vatam),2) , '0') FROM ~#~dtrans where transtype = '0' and date between '~Date from~' and '~Date to~'  and vatam != '0') AS TotalInvoiceExcl,
(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '0' and date between '~Date from~' and '~Date to~' ) AS TotalInvoiceVat,
(SELECT IFNULL( round(sum(abs(qty) * cost),2) , '0') FROM ~#~sttrans where transtype = '0' AND date between '~Date from~' and '~Date to~') AS TotalInvoiceCostExcl,
(SELECT IFNULL( round(sum(abs(qty) * cost),2) , '0') FROM ~#~sttrans where transtype = '0' AND date between '~Date from~' and '~Date to~') AS TotalInvoiceCostVat,
(SELECT IFNULL( sum(abs(qty)) , '0') FROM ~#~sttrans where transtype = '0' AND date between '~Date from~' and '~Date to~') AS TotalInvoiceQty,
(SELECT IFNULL( round(sum(transam),2) , '0') FROM ~#~dtrans where transtype = '0' AND date between '~Date from~' and '~Date to~' and vatam = '0') AS TotalInvoiceExmpt,
(SELECT IFNULL( round(sum(abs(qty) * cost),2) , '0') FROM ~#~sttrans where transtype = '0' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalInvoiceExmptCost,
(SELECT IFNULL( round(sum(transAm)*-1-sum(vatam),2) , '0') FROM ~#~dtrans where transtype = '8' and date between '~Date from~' and '~Date to~' ) AS TotalCrNotesExcl,
(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '8' and date between '~Date from~' and '~Date to~' ) AS TotalCrNotesVat,
(SELECT IFNULL( round(sum(abs(qty) * cost),2) , '0') FROM ~#~sttrans where transtype = '8' AND date between '~Date from~' and '~Date to~') AS TotalCrNotesCostExcl,
(SELECT IFNULL( round(sum(abs(qty) * cost)*0.14,2) , '0') FROM ~#~sttrans where transtype = '8' AND date between '~Date from~' and '~Date to~' and vat != '0') AS TotalCrNotesCostVat,
(SELECT IFNULL( sum(abs(qty)) , '0') FROM ~#~sttrans where transtype = '8' AND date between '~Date from~' and '~Date to~') AS TotalCrNoteQty,
(SELECT IFNULL( round(sum(abs(qty) * price),2) , '0') FROM ~#~sttrans where transtype = '8' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalCrNoteExmptExcl,
(SELECT IFNULL( round(sum(abs(qty) * cost),2) , '0') FROM ~#~sttrans where transtype = '8' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalCrNoteExmptCost,
(SELECT IFNULL( sum(abs(qty)*price) , '0') FROM ~#~sttrans where transtype = '6' AND date between '~Date from~' and '~Date to~') AS TotalGRNCostExcl,
(SELECT IFNULL( round(sum(vat),2) , '0') FROM ~#~sttrans where transtype = '6' AND date between '~Date from~' and '~Date to~') AS TotalGRNCostVat,
(SELECT IFNULL( round(sum(~#~sttrans.qty*~#~stockt2.sp1)*100/114,2) , '0') FROM ~#~sttrans, ~#~stockt2 where ~#~sttrans.code = ~#~stockt2.code and transtype = '6' AND date between '~Date from~' and '~Date to~') AS TotalGRNRSPExcl,
(SELECT IFNULL( round(sum(~#~sttrans.qty*~#~stockt2.sp1)*0.14,2) , '0') FROM ~#~sttrans, ~#~stockt2 where ~#~sttrans.code = ~#~stockt2.code and ~#~sttrans.transtype = '6' AND ~#~sttrans.date between '~Date from~' and '~Date to~' AND ~#~sttrans.vat != '0') AS TotalGRNRSPVat,
(SELECT IFNULL( sum(qty) , '0') FROM ~#~sttrans where transtype = '6' AND date between '~Date from~' and '~Date to~') AS TotalGRNQty,
(SELECT IFNULL( round(sum(abs(qty) * price),2) , '0') FROM ~#~sttrans where transtype = '6' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalGRNExmptCost,
(SELECT IFNULL( round(sum(~#~sttrans.qty*~#~stockt2.sp1),2) , '0') FROM ~#~sttrans, ~#~stockt2 where ~#~sttrans.code = ~#~stockt2.code and transtype = '6' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalGRNExmptRSP,
(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~ctrans where transtype = '9' and date between '~Date from~' and '~Date to~' ) AS TotalCrdDrNotesCostExcl,
(SELECT IFNULL( round(sum(vatam),2) , '0') FROM ~#~ctrans where transtype = '9' and date between '~Date from~' and '~Date to~' ) AS TotalCrdDrNotesCostVat,
(SELECT IFNULL( round(sum(abs(~#~sttrans.qty)*~#~stockt2.sp1)*100/114,2) , '0') FROM ~#~sttrans, ~#~stockt2 where ~#~sttrans.code = ~#~stockt2.code and transtype = '9' AND date between '~Date from~' and '~Date to~') AS TotalCrdDrNotesRSPExcl,
(SELECT IFNULL( sum(abs(qty)) , '0') FROM ~#~sttrans where transtype = '9' AND date between '~Date from~' and '~Date to~') AS TotalCrdDrNotesQty,
(SELECT IFNULL( round(sum(abs(qty) * price),2) , '0') FROM ~#~sttrans where transtype = '9' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalCrdDrNotesExmptCost,
(SELECT IFNULL( round(sum(abs(~#~sttrans.qty)*~#~stockt2.sp1),2) , '0') FROM ~#~sttrans, ~#~stockt2 where ~#~sttrans.code = ~#~stockt2.code and transtype = '9' AND date between '~Date from~' and '~Date to~' and vat = '0') AS TotalCrdDrNotesExmptRSP,
(SELECT IFNULL( round(sum(soh*acp),2) , '0') FROM ~#~stockt2 where soh > '0') AS StockValueAvgCostExcl,
(SELECT IFNULL( round(sum(soh*cpe),2) , '0') FROM ~#~stockt2 where soh > '0') AS StockValueLatestCostExcl,
(SELECT IFNULL( round(sum(soh*sp1)*100/114,2) , '0') FROM ~#~stockt2 where soh > '0') AS StockValueRSPExcl,
(SELECT IFNULL( sum(soh) , '0') FROM ~#~stockt2 where soh > '0') AS TotalStockQty,
(SELECT IFNULL( sum(abs(qty)) , '0') FROM ~#~sttrans where transtype = '2' AND date between '~Date from~' and '~Date to~') AS TotalDebitAdjQty,
(SELECT IFNULL( sum(abs(qty)*price) , '0') FROM ~#~sttrans where transtype = '2' AND date between '~Date from~' and '~Date to~') AS TotalDebitAdjValue,
(SELECT IFNULL( sum(abs(qty)) , '0') FROM ~#~sttrans where transtype = '3' AND date between '~Date from~' and '~Date to~') AS TotalCreditAdjQty,
(SELECT IFNULL( sum(abs(qty)*price) , '0') FROM ~#~sttrans where transtype = '3' AND date between '~Date from~' and '~Date to~') AS TotalCreditAdjValue,
(SELECT IFNULL( count(*) , '0') FROM ~#~dtrans where transtype = '0' and date between '~Date from~' and '~Date to~') AS NumCustomers,
(SELECT IFNULL( round(sum(osbal),2) , '0') FROM ~#~debtors where laybye = '0' and accnum != 'CASH') AS TotalDebtorsOS,
(SELECT IFNULL( round(sum(pdcbal),2) , '0') FROM ~#~debtors) AS TotalDebtorsPDC,
(SELECT IFNULL( round(sum(osbal),2) , '0') FROM ~#~debtors where laybye = '1') AS TotalLaybye,
(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = '5' and date between '~Date from~' and '~Date to~' and accnum not in (SELECT IFNULL( accnum , '0') FROM ~#~debtors where laybye = '0')) AS TotalLaybyeReceipts,
(SELECT IFNULL( round(sum(osbal),2) , '0') FROM ~#~creditors) AS TotalCreditorsOS,
(SELECT IFNULL( round(sum(value),2) , '0') FROM ~#~pettycash where closed = '0' and num != 'NA' and date(pdate) = date(now())) AS TotalPettyCashOpen,
(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~dtrans where transtype = 'P' and date between '~Date from~' and '~Date to~') AS TotalPettyCashClosed,
(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = '5'  and date between '~Date from~' and '~Date to~' and accnum not in (SELECT IFNULL( accnum , '0') FROM ~#~debtors where laybye = '1')) AS DebtorsReceipts,
(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~dtrans where transtype = '7' and date between '~Date from~' and '~Date to~' and accnum not in (SELECT IFNULL( accnum , '0') FROM ~#~debtors where laybye = '1')) AS DebtorsDiscounts,
(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = '2'  and date between '~Date from~' and '~Date to~') AS DebtorsJournalDr,
(SELECT IFNULL( round(sum(transAm * 0.14),2) , '0') FROM ~#~dtrans where transtype = '2'  and date between '~Date from~' and '~Date to~') AS DebtorsJournalDrVat,
(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~dtrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS DebtorsJournalCr,
(SELECT IFNULL( round(sum((transAm)*-1) * 0.14,2) , '0') FROM ~#~dtrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS DebtorsJournalCrVat,
(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = 'R' and date between '~Date from~' and '~Date to~') AS DebtorsRDCheque,
(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '5' and date between '~Date from~' and '~Date to~') AS CreditorsPayment,
(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '7' and date between '~Date from~' and '~Date to~') AS CreditorsDiscount,
(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~ctrans where transtype = '2' and date between '~Date from~' and '~Date to~') AS CreditorsJournalDr,
(SELECT IFNULL( round(sum(transAm * 0.14),2) , '0') FROM ~#~ctrans where transtype = '2' and date between '~Date from~' and '~Date to~') AS CreditorsJournalDrVat,
(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS CreditorsJournalCr,
(SELECT IFNULL( round(sum(transAm * 0.14)*-1,2) , '0') FROM ~#~ctrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS CreditorsJournalCrVat]]></queryString>

