	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		(SELECT dtype FROM doctype WHERE num =transtype) AS Description,
		IFNULL((select osbal from ~#~monthenddebtors where accnum = '~Acc no~' and date(date) = '~Date from~' order by date desc limit 1),0.00) AS Opening_Bal,
		(select name from ~#~debtors where accnum = '~Acc no~') As Accname,
		(select osbal from ~#~debtors where accnum = '~Acc no~') As Osbal,
		docnum AS Ref_no, 
		date AS Date, 
		IF(transtype = 'R',transam * -1,transam) AS Debit,
		'' AS Credit
FROM 		~#~dtrans 
WHERE 		transtype IN ('0','2','R','4')
AND		paytype = '5'
AND		accnum = '~Acc no~'
AND		date between '~Date from~' and  '~Date to~'
AND		(transtype != '0' or paytype != '1' )

UNION
SELECT 		(SELECT dtype FROM doctype WHERE num =transtype) AS Description,
		IFNULL((select osbal from ~#~monthenddebtors where accnum = '~Acc no~' and date(date) = '~Date from~' order by date desc limit 1),0.00) AS Opening_Bal,
		(select name from ~#~debtors where accnum = '~Acc no~') As Accname,
		(select osbal from ~#~debtors where accnum = '~Acc no~') As Osbal,
		docnum AS Ref_no, 
		date AS Date, 
		'' AS Debit, 
		transam AS Credit
FROM 		~#~dtrans 
WHERE 		transtype IN ('1','3','5','7','D','8') 
AND		accnum = '~Acc no~'
AND		date between '~Date from~' and '~Date to~'
AND 		(transtype != '7' or agent = '-')
AND		(transtype != '8' or paytype != '1' )
ORDER BY 	date]]></queryString>

	<field name="Description" class="java.lang.String"/>
	<field name="Opening_Bal" class="java.lang.Double"/>
	<field name="Accname" class="java.lang.String"/>
	<field name="Ref_no" class="java.lang.String"/>
	<field name="Date" class="java.sql.Date"/>
	<field name="Debit" class="java.lang.Double"/>
	<field name="Credit" class="java.lang.Double"/>
	<field name="Osbal" class="java.lang.Double"/>

