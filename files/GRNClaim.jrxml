	<queryString><![CDATA[select code, descr, qty, price,  (select cpe from m1stockt2 where  m1stockt2.code =  m1cordtrans.code) as oriCP, 
if((price- (select cpe from m1stockt2 where  m1stockt2.code =  m1cordtrans.code)) <0 ,'0',if((select vati from m1stockt2 where  m1stockt2.code =  m1cordtrans.code)='0','0',round((price- (select cpe from m1stockt2 where  m1stockt2.code =  m1cordtrans.code))*qty*(select vatrate from codetails where conum = 'm1'),2))) as vatamt, 
round(if((price- (select cpe from m1stockt2 where  m1stockt2.code =  m1cordtrans.code)) <0 ,'0',(price- (select cpe from m1stockt2 where  m1stockt2.code =  m1cordtrans.code))*qty),2) as adj,
(select accnum from m1corder where docnum = '~B~') as accnum ,
 (select name from m1creditors where accnum = (select accnum from m1corder where docnum = '~B~')) as name
from m1cordtrans where docnum = '~B~']]></queryString>

