	<queryString><![CDATA[SELECT 		accnum AS Acc_num,
		name AS Acc_name,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(NOW(),'%Y%m')),0.00) AS Current,
		(SELECT DATE_FORMAT(NOW(),'%b-%y')) AS CurCol,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 1 MONTH),'%Y%m')),0.00) AS M1,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 1 MONTH),'%b-%y')) AS Col1,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 2 MONTH),'%Y%m')),0.00) AS M2,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 2 MONTH),'%b-%y')) AS Col2,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 3 MONTH),'%Y%m')),0.00) AS M3,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 3 MONTH),'%b-%y')) AS Col3,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 4 MONTH),'%Y%m')),0.00) AS M4,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 4 MONTH),'%b-%y')) AS Col4,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 5 MONTH),'%Y%m')),0.00) AS M5,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 5 MONTH),'%b-%y')) AS Col5,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 6 MONTH),'%Y%m')),0.00) AS M6,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 6 MONTH),'%b-%y')) AS Col6,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 7 MONTH),'%Y%m')),0.00) AS M7,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 7 MONTH),'%b-%y')) AS Col7,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 8 MONTH),'%Y%m')),0.00) AS M8,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 8 MONTH),'%b-%y')) AS Col8,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 9 MONTH),'%Y%m')),0.00) AS M9,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 9 MONTH),'%b-%y')) AS Col9,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 10 MONTH),'%Y%m')),0.00) AS M10,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 10 MONTH),'%b-%y')) AS Col10,
		IFNULL((SELECT SUM(transam) FROM ~#~ctrans WHERE accnum = ~#~creditors.accnum AND DATE_FORMAT(~#~ctrans.date,'%Y%m') = DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 11 MONTH),'%Y%m')),0.00) AS M11,
		(SELECT DATE_FORMAT(DATE_SUB(NOW(), INTERVAL 11 MONTH),'%b-%y')) AS Col11
FROM 		~#~creditors
WHERE 		accnum BETWEEN '~Acc from~' AND '~Acc to~']]></queryString>

