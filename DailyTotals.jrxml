	<queryString><![CDATA[select 
ddate as DayendDate,
TotalInvoiceExcl as TotalInvoiceExcl,
TotalInvoiceVat as TotalInvoiceVat,
TotalInvoiceCostExcl as TotalInvoiceCostExcl,
TotalInvoiceCostVat as TotalInvoiceCostVat,
round((TotalInvoiceExcl-TotalInvoiceCostExcl)/TotalInvoiceExcl*100) as InvoiceGP,
TotalCrNotesExcl as TotalCrNotesExcl,
TotalCrNotesVat as TotalCrNotesVat,
TotalCrNotesCostExcl as TotalCrNotesCostExcl,
TotalCrdDrNotesCostExcl as TotalCrdDrNotesCostExcl,
TotalCrdDrNotesCostVat as TotalCrdDrNotesCostVat,
TotalGRNCostExcl as TotalGRNCostExcl,
TotalGRNCostVat as TotalGRNCostVat,
round((TotalGRNRSPExcl-TotalGRNCostExcl)/TotalGRNRSPExcl*100) as PurchasesGP,
TotalDebitAdjValue as TotalDebitAdjValue,
TotalCreditAdjValue as TotalCreditAdjValue
from ~#~dayend where date(ddate) between '~Date from~' and '~Date to~' and Manager = 'Y']]></queryString>

