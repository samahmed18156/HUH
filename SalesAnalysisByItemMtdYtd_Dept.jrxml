	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	~#~sttrans.code AS Code, 
	if(length(substring(~#~stockt2.code,1,instr(~#~stockt2.code,'|')-1)) > 0,substring(~#~stockt2.code,1,instr(~#~stockt2.code,'|')-1),~#~stockt2.code) AS Code_sorter,
	~#~stockt2.descr AS Description, 
	~#~stockt2.soh AS SOH, 
	~#~stockt2.qmtd AS QTY_MTD,
	ROUND(~#~stockt2.valmtd,2) AS VAL_MTD,
	~#~stockt2.qytd AS QTY_YTD,
	ROUND(~#~stockt2.valytd,2) AS VAL_YTD,
	ROUND(~#~stockt2.cpi,2) AS COST_INCL,
	ROUND(~#~stockt2.sp1,2) AS SELLING_INCL
	
FROM 		~#~sttrans, ~#~stockt2 
WHERE 		~#~sttrans.code BETWEEN '~Code from~' AND '~Code to~' 
AND 		~#~sttrans.code = ~#~stockt2.code  
AND 		(~#~sttrans.transtype = '0' or ~#~sttrans.transtype = '8' or ~#~sttrans.transtype = '4')
AND 		~#~STOCKT2.DEPT LIKE '~Dept~'
AND		~#~stockt2.suply LIKE '~Supplier~'
GROUP BY 	~#~stockt2.code
ORDER BY        Description]]></queryString>

