	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
(SELECT IFNULL(round(sum(dtrans.transAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('0') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalInvoices ,
(SELECT IFNULL(round(sum(dtrans.vatam),2),'0')   FROM ~#~dtrans as dtrans WHERE transtype IN ('0') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalVat,
(SELECT IFNULL(round(sum(dtrans.transAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('5') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalReceipts,
(SELECT IFNULL(round(sum(dtrans.transAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('3') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalJrnlDr,
(SELECT IFNULL(round(sum(dtrans.transAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('2') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalJrnlCr,
(SELECT IFNULL(round(sum(dtrans.transAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('7') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalDisc,
(SELECT IFNULL(round(sum(dtrans.transAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('8') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalCreditNotes,
(SELECT IFNULL(round(sum(dtrans.vatAm),2),'0') FROM ~#~dtrans as dtrans WHERE transtype IN ('8') and date BETWEEN '~Date from~' AND '~Date to~' AND agent = '~Agent number~') AS TotalCreditNotesVat
FROm DUAL;]]></queryString>

