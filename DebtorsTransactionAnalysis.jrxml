<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Debtors Transaction Analysis"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		accnum AS AccNum,
		name AS AccName,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~quotes WHERE ~#~quotes.accnum = ~#~debtors.accnum AND date BETWEEN '~Date from~' AND '~Date to~' ),'0.00') AS QuoteIncl,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '0' AND date BETWEEN '~Date from~' AND '~Date to~' ),'0.00') AS InvoiceIncl,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '8' AND date BETWEEN '~Date from~' AND '~Date to~'),'0.00') AS CrNoteIncl,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '2' AND date BETWEEN '~Date from~' AND '~Date to~' ),'0.00') AS JrDr,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '3' AND date BETWEEN '~Date from~' AND '~Date to~' ),'0.00') AS JrCr,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '5' AND date BETWEEN '~Date from~' AND '~Date to~'),'0.00') AS Receipts,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '7' AND date BETWEEN '~Date from~' AND '~Date to~' AND agent <> '-'),'0.00') AS InvDisc,
		IFNULL((SELECT ABS(SUM(transam)) FROM ~#~dtrans WHERE ~#~dtrans.accnum = ~#~debtors.accnum AND transtype = '7' AND date BETWEEN '~Date from~' AND '~Date to~' AND agent = '-'),'0.00') AS SettleDisc
FROM 		~#~debtors 
WHERE 		accnum BETWEEN '~Acc from~' AND '~Acc to~'
GROUP BY 	accnum
HAVING 		(QuoteIncl != '0.00')OR(InvoiceIncl != '0.00')OR(CrNoteIncl != '0.00')OR(JrDr != '0.00')OR(JrCr != '0.00')OR(Receipts != '0.00')OR(InvDisc != '0.00')OR(SettleDisc != '0.00');]]></queryString>

	<field name="AccNum" class="java.lang.String"/>
	<field name="AccName" class="java.lang.String"/>
	<field name="QuoteIncl" class="java.lang.Double"/>
	<field name="InvoiceIncl" class="java.lang.Double"/>
	<field name="CrNoteIncl" class="java.lang.Double"/>
	<field name="JrCr" class="java.lang.Double"/>
	<field name="JrDr" class="java.lang.Double"/>
	<field name="Receipts" class="java.lang.Double"/>
	<field name="InvDisc" class="java.lang.Double"/>
	<field name="SettleDisc" class="java.lang.Double"/>

	<variable name="TotalInvoiceIncl" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{InvoiceIncl}]]></variableExpression>
	</variable>
	<variable name="TotalQuoteIncl" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{QuoteIncl}]]></variableExpression>
	</variable>
	<variable name="TotalJrDr" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{JrDr}]]></variableExpression>
	</variable>
	<variable name="TotalJrCr" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{JrCr}]]></variableExpression>
	</variable>
	<variable name="TotalReceipts" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Receipts}]]></variableExpression>
	</variable>
	<variable name="TotalInvDisc" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{InvDisc}]]></variableExpression>
	</variable>
	<variable name="TotalSettleDisc" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SettleDisc}]]></variableExpression>
	</variable>

