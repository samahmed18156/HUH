	<variable name="total" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{VatReceived}.doubleValue()) +($F{VatPaid}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totInvIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalInvoiceExcl}.doubleValue()) +($F{TotalInvoiceVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totCrNoteIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalCrNotesExcl}.doubleValue()) +($F{TotalCrNotesVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totDebtorsJrDrIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{DebtorsJournalDr}.doubleValue()) -($F{DebtorsJournalDrVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totDebtorsJrCrIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{DebtorsJournalCr}.doubleValue()) -($F{DebtorsJournalCrVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totCreditorsGRNIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  (($F{TotalGRNCostExcl}.doubleValue()) -($F{TotalGRNCostVat}.doubleValue())) )]]></variableExpression>
	</variable>
	<variable name="totCreditorsDrNotesIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalCrdDrNotesCostExcl}.doubleValue()) -($F{TotalCrdDrNotesCostVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totCreditorsJrDrIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{CreditorsJournalDr}.doubleValue()) -($F{CreditorsJournalDrVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totCreditorsJrCrIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{CreditorsJournalCr}.doubleValue()) -($F{CreditorsJournalCrVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totDebtorsDiscIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalDebtorsDisc}.doubleValue()) -($F{TotalDebtorsDiscVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totCreditorsDiscIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalCreditorsDisc}.doubleValue()) -($F{TotalCreditorsDiscVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totDebtorsVatAmt" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalInvoiceVat}.doubleValue()) +($F{TotalCrNotesVat}.doubleValue()) +($F{DebtorsJournalDrVat}.doubleValue()) +($F{DebtorsJournalCrVat}.doubleValue()) 
+ ($F{TotalLaybyesVat}.doubleValue())
+($F{TotalDebtorsDiscVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totDebtorsAmtIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{totInvIncl}.doubleValue()) +($V{totCrNoteIncl}.doubleValue()) 
+($F{DebtorsJournalDr}.doubleValue()) + ($F{DebtorsJournalCr}.doubleValue()) 
+ ($F{TotalLaybyes}.doubleValue())
+ ($F{TotalDebtorsDisc}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="totCreditorsVatAmt" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalGRNCostVat}.doubleValue()) +($F{TotalCrdDrNotesCostVat}.doubleValue()) +($F{CreditorsJournalDrVat}.doubleValue()) +($F{CreditorsJournalCrVat}.doubleValue()) +($F{TotalCreditorsDiscVat}.doubleValue()) + ($F{TotalExpenseVat}.doubleValue())    )]]></variableExpression>
	</variable>
	<variable name="totCreditorsAmtIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalGRNCostExcl}.doubleValue()) +($F{TotalCrdDrNotesCostExcl}.doubleValue()) +($F{CreditorsJournalDr}.doubleValue()) +($F{CreditorsJournalCr}.doubleValue()) +($F{TotalCreditorsDisc}.doubleValue()) + ($F{TotalExpense}.doubleValue())    )]]></variableExpression>
	</variable>
	<variable name="InvAmtIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{AmountReceived}.doubleValue()) -($F{TotalInvoiceExmpt}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totLaybyesExcl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalLaybyes}.doubleValue()) -($F{TotalLaybyesVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totDebtorsAmtExcl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalInvoiceExcl}.doubleValue()) +($F{TotalCrNotesExcl}.doubleValue()) 
+($V{totDebtorsJrDrIncl}.doubleValue()) + ($V{totDebtorsJrCrIncl}.doubleValue()) 
+ ($V{totLaybyesExcl}.doubleValue())
+ ($V{totDebtorsDiscIncl}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="totExpenseIncl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{TotalExpense}.doubleValue()) -($F{TotalExpenseVat}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="totCreditorsAmtExcl" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{totCreditorsAmtIncl}.doubleValue()) +($V{totCreditorsVatAmt}.doubleValue())  )]]></variableExpression>
	</variable>
