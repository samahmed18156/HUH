<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="VatReport"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT
	IFNULL((SELECT ROUND(SUM(transam),2)  FROM ~#~dtrans where date BETWEEN '~Date from~' AND '~Date to~' AND transtype IN ('0','2', '7', '8', '3', '4') ),0.00) AS AmountReceived,
	IFNULL((SELECT ROUND(SUM(vatam),2)  FROM ~#~dtrans where date BETWEEN '~Date from~' AND '~Date to~' AND transtype IN ('0', '2', '7','8','3','4')),0.00) AS VatReceived,
	IFNULL((SELECT ROUND(SUM(transam * -1),2)  FROM ~#~ctrans where date BETWEEN '~Date from~' AND '~Date to~' AND transtype IN ( '2', '6', '7', '9','3', 'E')) ,0.00) AS AmountPaid,
	IFNULL((SELECT ROUND(SUM(vatam * -1),2)  FROM ~#~ctrans where date BETWEEN '~Date from~' AND '~Date to~' AND transtype IN ( '2', '6', '7', '9', '3', 'E')),0.00) AS VatPaid,
	(SELECT '~Date from~') As StartDate,
	(SELECT '~Date to~') As EndDate,
	(SELECT IFNULL( round(sum(transAm)-sum(vatam),2) , '0') FROM ~#~dtrans where transtype = '0' and date between '~Date from~' and '~Date to~' ) AS TotalInvoiceExcl,
	(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '0' and date between '~Date from~' and '~Date to~' ) AS TotalInvoiceVat,
	(SELECT IFNULL( round(sum(transam),2) , '0') FROM ~#~dtrans where transtype = '0' AND accnum in (select accnum from ~#~debtors where vatind = '0') AND date between '~Date from~' and '~Date to~' and vatam = '0') AS TotalInvoiceExmpt,
	(SELECT IFNULL( round(sum(transAm)-sum(vatam),2) , '0') FROM ~#~dtrans where transtype = '8' and date between '~Date from~' and '~Date to~' ) AS TotalCrNotesExcl,
	(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '8' and date between '~Date from~' and '~Date to~' ) AS TotalCrNotesVat,
	(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = '2'  and date between '~Date from~' and '~Date to~') AS DebtorsJournalDr,
	(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '2'  and date between '~Date from~' and '~Date to~') AS DebtorsJournalDrVat,
	(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS DebtorsJournalCr,
	(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS DebtorsJournalCrVat,
	(SELECT IFNULL( round(sum(transam),2) , '0') FROM ~#~dtrans where transtype = '7' AND date between '~Date from~' and '~Date to~' and vatam != '0') AS TotalDebtorsDisc,
	(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '7' AND date between '~Date from~' and '~Date to~' ) AS TotalDebtorsDiscVat,
	(SELECT IFNULL( round(sum(transAm),2) , '0') FROM ~#~dtrans where transtype = '4'  and date between '~Date from~' and '~Date to~') AS TotalLaybyes,
	(SELECT IFNULL( round(sum(vatAm),2) , '0') FROM ~#~dtrans where transtype = '4' and date between '~Date from~' and '~Date to~' ) AS TotalLaybyesVat,
	(SELECT IFNULL( round(sum(transam)*-1,2) , '0') FROM ~#~ctrans where transtype = '6' AND date between '~Date from~' and '~Date to~') AS TotalGRNCostExcl,
	(SELECT IFNULL( round(sum(vatAm)* -1,2) , '0') FROM ~#~ctrans where transtype = '6' AND date between '~Date from~' and '~Date to~') AS TotalGRNCostVat,
	(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '9' and date between '~Date from~' and '~Date to~' ) AS TotalCrdDrNotesCostExcl,
	(SELECT IFNULL( round(sum(vatam)*-1,2) , '0') FROM ~#~ctrans where transtype = '9' and date between '~Date from~' and '~Date to~' ) AS TotalCrdDrNotesCostVat,
	(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '2' and date between '~Date from~' and '~Date to~') AS CreditorsJournalDr,
	(SELECT IFNULL( round(sum(vatam)*-1,2) , '0') FROM ~#~ctrans where transtype = '2' and date between '~Date from~' and '~Date to~') AS CreditorsJournalDrVat,
	(SELECT IFNULL( round(sum(transAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS CreditorsJournalCr,
	(SELECT IFNULL( round(sum(vatam)*-1,2) , '0') FROM ~#~ctrans where transtype = '3' and date between '~Date from~' and '~Date to~') AS CreditorsJournalCrVat,
	(SELECT IFNULL( round(sum(transam)*-1,2) , '0') FROM ~#~ctrans where transtype = '7' AND date between '~Date from~' and '~Date to~') AS TotalCreditorsDisc,
	(SELECT IFNULL( round(sum(vatAm)*-1,2) , '0') FROM ~#~ctrans where transtype = '7' AND date between '~Date from~' and '~Date to~') AS TotalCreditorsDiscVat,
	(SELECT IFNULL( round(sum(transam)*-1,2) , '0') FROM ~#~ctrans where transtype = 'E' AND date between '~Date from~' and '~Date to~') AS TotalExpense,
	(SELECT IFNULL( round(sum(vatAm)*-1,2) , '0') FROM ~#~ctrans where transtype = 'E' AND date between '~Date from~' and '~Date to~') AS TotalExpenseVat,
	(SELECT IFNULL( round(sum(qty*price)*-1,2) , '0') FROM ~#~sttrans where transtype = '0'  and vat = '0' and instr(descr,'*') > 0 AND date between '~Date from~' and '~Date to~' ) AS TotalItemExempt
FROM DUAL;]]></queryString>

