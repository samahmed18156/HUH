	<queryString><![CDATA[select
(select count(*) from ~#~voids where date between '~Date from~' and '~Date to~' and user like '~User~' and itmnum = '0' ) as Num_Voids,
(select count(*) from ~#~dtrans where date between '~Date from~' and '~Date to~' and user like '~User~' and transtype = '8' )as Cr_Notes,
(select count(*) from ~#~sttrans where date between '~Date from~' and '~Date to~' and user like '~User~' and price != oprice ) AS Price_Changes,
(select count(*) from ~#~dtrans where date between '~Date from~' and '~Date to~' and user like '~User~' and transtype = '7' ) as Discounts,
(select count(*) from ~#~dtrans where date between '~Date from~' and '~Date to~' and user like '~User~' and transtype = '0' ) as Invoices,
(select count(*) from ~#~sttrans where date between '~Date from~' and '~Date to~' and user like '~User~' and transtype = '0' ) as ItemsSold,
(select round(avg(transAm),2) from ~#~dtrans where date between '~Date from~' and '~Date to~' and user like '~User~' and transtype = '0' ) as AvgSale]]></queryString>

