<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Invoice"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="226"
		 pageHeight="1542"
		 columnWidth="166"
		 columnSpacing="0"
		 leftMargin="10"
		 rightMargin="10"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	c.user as user, 
	(select concat(name,' ',surname) from m1users where id = c.user) as name,
	(select dtype from doctype where num = d.transtype) as doc, 
	(select ptype from paytype where num = d.paytype) as payment,
	round(if(d.transtype = '5',-1,if(d.transtype = '4' and paytype in('1','2','3','8'), -1,1))*sum(d.transam),2) as TrAm,
	(select name from codetails where conum = 'm1') as co,
	0.0 as zer,
	cash  as cash,
	card as  card,
	payout  as payout,
	`float` as flt,
	 total as tot,
	(select GROUP_CONCAT(concat(descr,' R',round(value,2))) from m1pettycash where date(pdate) = d.date) as payouts,
	(select count(*) from m1cashup where date = date(now()) and user = 'adm') printTimes,
	date(now()) as cdate,
	@seqNo:=seqNo  as seqNo
from M1cashup as c, m1dtrans as d
where c.user = 'adm' and concat(c.date,' ', c.time) = (select max(concat(date,' ', time)) from m1cashup where user = 'adm')
and concat(d.date,' ', d.time) between (select max(concat(date,' ', time)) from m1cashup where seqno  < @seqNo and user = 'adm' ) and concat(c.date,' ', c.time)]]></queryString>

	<field name="user" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="doc" class="java.lang.String"/>
	<field name="payment" class="java.lang.String"/>
	<field name="TrAm" class="java.lang.Double"/>
	<field name="co" class="java.lang.String"/>
	<field name="zer" class="java.lang.Double"/>
	<field name="cash" class="java.lang.Double"/>
	<field name="card" class="java.lang.Double"/>
	<field name="payout" class="java.lang.Double"/>
	<field name="flt" class="java.lang.Double"/>
	<field name="tot" class="java.lang.Double"/>
	<field name="payouts" class="java.lang.String"/>
	<field name="printTimes" class="java.lang.String"/>
	<field name="cdate" class="java.lang.String"/>
	<field name="seqNo" class="java.lang.String"/>

	<variable name="SUM_Cash_Trans" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Sum">
		<variableExpression><![CDATA[( $F{payment}.equals( "Cash" ) ? $F{TrAm} : $F{zer} )]]></variableExpression>
	</variable>
	<variable name="SUM_Cheque_Trans" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Sum">
		<variableExpression><![CDATA[( $F{payment}.equals( "Cheque" ) ? $F{TrAm} : $F{zer} )]]></variableExpression>
	</variable>
	<variable name="SUM_Card_Trans" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Sum">
		<variableExpression><![CDATA[( $F{payment}.equals( "Credit Card" ) ? $F{TrAm} : $F{zer} )]]></variableExpression>
	</variable>
	<variable name="SUM_Bank_Trans" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Sum">
		<variableExpression><![CDATA[( $F{payment}.equals( "Bank Transfer" ) ? $F{TrAm} : $F{zer} )]]></variableExpression>
	</variable>
	<variable name="SUM_Other_Trans" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Sum">
		<variableExpression><![CDATA[( $F{payment}.equals( "Other" ) ? $F{TrAm} : $F{zer} )]]></variableExpression>
	</variable>
	<variable name="SUM_Acc_Trans" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Sum">
		<variableExpression><![CDATA[( $F{payment}.equals( "Account" ) ? $F{TrAm} : $F{zer} )]]></variableExpression>
	</variable>
	<variable name="SUM_SUM_Cash_Trans_1" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{SUM_Cash_Trans}.doubleValue()) +($V{SUM_Cheque_Trans}.doubleValue())+($V{SUM_Card_Trans}.doubleValue())+($V{SUM_Bank_Trans}.doubleValue())+($V{SUM_Other_Trans}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="DIFF" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[$V{cardDiff}]]></variableExpression>
	</variable>
	<variable name="OUCash" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[( $V{cashDiff}.doubleValue() ==  $F{zer}.doubleValue()  ? "Balance" :( $V{cashDiff}.doubleValue() > $F{zer}.doubleValue()  ? "Over" :"Short"))]]></variableExpression>
	</variable>
	<variable name="BankAm" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{cash}.doubleValue()) -($F{flt}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="cashDiff" class="java.lang.Double" resetType="Group" resetGroup="UserTotal" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double( ($V{BankAm}.doubleValue()) -  ($V{SUM_Cash_Trans}.doubleValue()) +  ($F{payout}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="cardDiff" class="java.lang.Double" resetType="Column" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double( ($F{card}.doubleValue())- ($V{SUM_Card_Trans}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="OUCard" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[( $V{cardDiff}.doubleValue() == $F{zer}.doubleValue()  ? "Balance" :( $V{cardDiff}.doubleValue() > $F{zer}.doubleValue()  ? "Over" :"Short"))]]></variableExpression>
	</variable>
	<variable name="OUDiff" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[( $V{TDiff}.doubleValue() == $F{zer}.doubleValue()  ? "Balance" :( $V{TDiff}.doubleValue() < $F{zer}.doubleValue()  ? "Over" :"Short"))]]></variableExpression>
	</variable>
	<variable name="TotalCountd" class="java.lang.Double" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{cash}.doubleValue()) -($F{flt}.doubleValue()) + ($F{payout}.doubleValue()) +($F{card}.doubleValue())  )]]></variableExpression>
	</variable>
	<variable name="TDiff" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{cashDiff}.doubleValue()) +($V{cardDiff}.doubleValue()) )]]></variableExpression>
	</variable>

