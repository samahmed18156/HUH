	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		code, 
		descr,
		@qoh:=round(if('~Warehouse~'='%',soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0),if('~Warehouse~'='SOH',soh,ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code and ~#~qoh.SohWH = '~Warehouse~'),0))),2) as sohw,

		ROUND(cpe,2) AS UnitCostExcl, 
		ROUND((if('~Warehouse~'='%',soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0),if('~Warehouse~'='SOH',soh,ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code and ~#~qoh.SohWH = '~Warehouse~'),0)))*cpe),2) as CostExcl, 

		ROUND(cpi,2) AS UnitCostIncl, 
		ROUND((if('~Warehouse~'='%',soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0),if('~Warehouse~'='SOH',soh,ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code and ~#~qoh.SohWH = '~Warehouse~'),0)))*cpi),2) as CostIncl, 


		ROUND(SP1,2) AS UnitSellingIncl, 
		ROUND((if('~Warehouse~'='%',soh+ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code),0),if('~Warehouse~'='SOH',soh,ifnull((select sum(qoh) from ~#~qoh where ~#~stockt2.code = ~#~qoh.code and ~#~qoh.SohWH = '~Warehouse~'),0)))*sp1),2) As SellingIncl 
FROM 		~#~stockt2 
HAVING		sohw > '0'
ORDER BY 	code ASC ;]]></queryString>

	<field name="code" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="UnitCostExcl" class="java.lang.Double"/>
	<field name="CostExcl" class="java.lang.Double"/>
	<field name="UnitCostIncl" class="java.lang.Double"/>
	<field name="CostIncl" class="java.lang.Double"/>
	<field name="UnitSellingIncl" class="java.lang.Double"/>
	<field name="SellingIncl" class="java.lang.Double"/>
	<field name="sohw" class="java.lang.Double"/>

	<variable name="SUM_CostExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CostExcl}]]></variableExpression>
	</variable>
	<variable name="SUM_SellingIncl _1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SellingIncl}]]></variableExpression>
	</variable>
	<variable name="SUM_UnitCostExcl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
