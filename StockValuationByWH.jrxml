	</variable>
	<variable name="SUM_CostIncl_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CostIncl}]]></variableExpression>
	</variable>
	<variable name="SUM_sohw" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{sohw}]]></variableExpression>
	</variable>
