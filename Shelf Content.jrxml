	<queryString><![CDATA[Select 
	~#~stocktake2.CODE as Code, 
	~#~stockt2.DESCR as Description, 
	~#~stocktake2.loc as Shelf ,
	~#~stocktake2.USER as User, 
	SUM(~#~stocktake2.QTY)as QTY 
from ~#~stocktake2, ~#~stockt2 
WHERE ~#~stocktake2.CODE = ~#~stockt2.CODE AND ~#~stocktake2.loc = '~Shelf number~' group by ~#~stocktake2.CODE]]></queryString>

