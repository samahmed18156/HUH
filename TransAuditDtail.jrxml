	<queryString><![CDATA[SELECT 
	date AS DATE, 
	time AS TIME, 
	(SELECT DTYPE FROM doctype WHERE NUM = transtype) as TYPE, 
	accnum AS ACCNUM, 
	docnum AS DOCNUM, 
	round(transAm,2) AS AMOUNT, 
	round(vatAm,2) AS VAT, 
	(SELECT PTYPE FROM paytype WHERE NUM = paytype) as PAY, 
	user AS USER
FROM ~#~dtrans where date >= '~From Date~' AND date <= '~To Date~' and user like '~User Name~';]]></queryString>

