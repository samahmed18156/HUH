	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		d.accnum AS Acc_no,
		d.name AS Acc_name, 
		d.tel1 AS Tel,
		t.date AS Acc_date,
		IFNULL(ROUND((SELECT SUM(ABS(qty * price)) FROM ~#~sttrans WHERE docnum = d.accnum AND transtype = '4'),2),0.00) AS Orig_amount,
		IFNULL(ROUND((SELECT SUM(ABS(transam)) FROM ~#~dtrans WHERE accnum = d.accnum AND transtype IN('4','5') AND paytype <> '5'),2),0.00) AS Paid
		
FROM 		~#~debtors d, ~#~dtrans t
WHERE 		d.accnum BETWEEN '0' AND 'zz'
AND 		t.transtype = '4'
AND 		t.accnum = d.accnum
AND		d.osbal != '0'
GROUP BY 	d.accnum
ORDER BY 	d.accnum, t.date]]></queryString>

	<field name="Acc_no" class="java.lang.String"/>
	<field name="Acc_name" class="java.lang.String"/>
	<field name="Tel" class="java.lang.String"/>
	<field name="Acc_date" class="java.sql.Date"/>
	<field name="Orig_amount" class="java.lang.Double"/>
	<field name="Paid" class="java.lang.Double"/>

	<variable name="balance" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Orig_amount}.doubleValue()) -($F{Paid}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="SUM_balance_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{balance}]]></variableExpression>
	</variable>
	<variable name="SUM_Paid_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Paid}]]></variableExpression>
	</variable>
