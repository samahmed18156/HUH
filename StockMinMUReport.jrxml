	<queryString><![CDATA[select 
	code as Code ,
	descr as Descr,
	cpe as CostPriceEx,
	sp1 as SellPrice, 
	round(((if((select vattype from codetails where conum = '~#~') = 'I',sp1,sp1*100/115)-cpe)/cpe)*100,2)  as MU 
from ~#~stockt2 having MU < '~Min MU~']]></queryString>

