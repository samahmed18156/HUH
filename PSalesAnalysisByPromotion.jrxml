		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT  	M1stockt2.code AS Stk_code, 
		M1stockt2.descr AS Descr,
		M1stockt2.promoStart AS Pro_start,
		M1stockt2.promoEnd AS Pro_end,
		SUM(M1sttrans.qty * -1) AS Qty_sold,
		ROUND(SUM(M1sttrans.qty * -1 * M1sttrans.price),2) AS Selling,
		ROUND(if(M1stockt2.vati = '0',SUM(M1sttrans.cost * M1sttrans.qty * -1),SUM(M1sttrans.cost * M1sttrans.qty * -1) + (SUM(M1sttrans.cost * M1sttrans.qty * -1) * 14/100)),2)  AS Cost
FROM 		M1stockt2, M1sttrans
WHERE		M1sttrans.code = M1stockt2.code
AND             M1stockt2.promoStart >= '2027-01-12' AND M1stockt2.promoEnd <= '2024-02-07'
AND 		M1sttrans.date BETWEEN M1stockt2.promoStart AND M1stockt2.promoEnd
AND 		M1sttrans.transtype IN ('0','8')
GROUP BY 	M1stockt2.code
ORDER BY 	M1stockt2.descr]]></queryString>

	<field name="Stk_code" class="java.lang.String"/>
	<field name="Descr" class="java.lang.String"/>
	<field name="Pro_start" class="java.sql.Date"/>
	<field name="Pro_end" class="java.sql.Date"/>
	<field name="Qty_sold" class="java.lang.Double"/>
	<field name="Selling" class="java.lang.Double"/>
	<field name="Cost" class="java.lang.Double"/>

	<variable name="profit" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Selling}.doubleValue()) -($F{Cost}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="SUM_Selling_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Selling}]]></variableExpression>
	</variable>
	<variable name="SUM_Cost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<variable name="SUM_profit_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{profit}]]></variableExpression>
	</variable>
