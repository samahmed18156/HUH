	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	date as tDate, 
	time as tTime, 
	accnum as accnum, 
	(select name from ~#~debtors where accnum = ~#~sttrans.accnum) as accname,
	docnum as docnum, 
	round(abs(qty * price),2) as Amount, 
	round(abs(vat),2) as Vat, 
	user as userName
from 	~#~sttrans 
where 	date between '~Date from~' and '~Date to~' 
and 	transtype = '0'
and 	accnum <> 'cash'
and 	vat = 0]]></queryString>

	<field name="tDate" class="java.sql.Date"/>
	<field name="tTime" class="java.sql.Time"/>
	<field name="accnum" class="java.lang.String"/>
	<field name="accname" class="java.lang.String"/>
	<field name="docnum" class="java.lang.String"/>
	<field name="Amount" class="java.lang.Double"/>
	<field name="Vat" class="java.lang.Double"/>
	<field name="userName" class="java.lang.String"/>

	<variable name="SUM_Amount_1" class="java.lang.Double" resetType="Report" calculation="Sum">
