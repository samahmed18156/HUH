	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	o.date as Date, 
	t.code as Code, 
	t.descr as Descr, 
	t.qty as Qty, 
	s.soh as SOH,
	t.price as Price, 
	(t.qty*t.price) as Value,
	t.docnum as Docnum, 
	o.accnum as AccNum, 
	o.ref as Ref
from ~#~corder as o, ~#~cordtrans as t, ~#~stockt2 as s
where o.docnum = t.docnum and s.code = t.code
and t.code like '~Code~'
and s.dept like '~Dept~'
and accnum like '~Accnum~'
and ref like '~Ref~']]></queryString>

