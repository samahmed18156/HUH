	<queryString><![CDATA[SELECT accnum, name, contact, concat(terms, ' Days') As Terms, concat(addr1,' ', addr2,' ', addr3,' ', pcode) As PostalAddress, concat(daddr1,' ', daddr2,' ', daddr3,' ', dcode) AS DeliveryAddress, tel1, vatnum, area, fax     
FROM ~#~creditors
WHERE ~Range~ BETWEEN '~Creditors from~' AND '~Creditors to~'
ORDER BY ~Range~ ASC, name ASC ;]]></queryString>

