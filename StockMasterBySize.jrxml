	<queryString><![CDATA[SELECT 		code, 	
		descr,
		concat('~#~','stockt2') as coNum,
		if(soh = 0,'',soh) AS soh
		
FROM 		~#~stockt2 
WHERE 		soh > ~SOH>~ 
AND           	~Range~ BETWEEN '~From~' AND '~To~' 
AND		ALTITEM = '0'
ORDER BY 	~Range~ ASC;]]></queryString>

	<field name="code" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="coNum" class="java.lang.String"/>
	<field name="soh" class="java.lang.String"/>

