	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	date as tDate, 
	time as tTime, 
	accnum as accnum, 
	transtype,
        (select dtype from doctype where num = transtype) as TransDesc,
	(select name from ~#~debtors where accnum = ~#~dtrans.accnum) as accname,
	docnum as docnum, 
	round(transam,2) as Amount, 
	round(vatam,2) as Vat, 
	(select ptype from paytype where num = paytype) as Payment, 
	user as userName
from ~#~dtrans 
where date between '~Date from~' and '~Date to~'  
order by transtype,date, time;]]></queryString>

	<field name="tDate" class="java.sql.Date"/>
	<field name="tTime" class="java.sql.Time"/>
	<field name="accnum" class="java.lang.String"/>
