	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	(select min(distinct(date(date))) from ~#~monthenddebtors where date(date) > '~Date from~') as nextDate,
	(SELECT addr1 FROM codetails where conum = '~#~') AS myAddr1,
	(SELECT addr2 FROM codetails where conum = '~#~') AS myAddr2,
	(SELECT addr3 FROM codetails where conum = '~#~') AS myAddr3,
	(SELECT code FROM codetails where conum = '~#~') AS myCode,
	(SELECT tel1 FROM codetails where conum = '~#~') AS Tel1,
	(SELECT tel2 FROM codetails where conum = '~#~') AS Tel2,
	(SELECT fax FROM codetails where conum = '~#~') AS Fax,
	(select name from ~#~debtors where accnum = '~Acc num~') as AccName,
	(select addr1 from ~#~debtors where accnum = '~Acc num~') as Addr1,
	(select addr2 from ~#~debtors where accnum = '~Acc num~') as Addr2,
	(select addr3 from ~#~debtors where accnum = '~Acc num~') as Addr3,
	(select pcode from ~#~debtors where accnum = '~Acc num~') as PCode,
	IFNULL((select balbf from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as balbf,
	@CURRBAL:=IFNULL((select CURRBAL from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as CURRBAL,
	@d30:=IFNULL((select D30 from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as D30,
	@d60:=IFNULL((select D60 from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as D60,
	@d90:=IFNULL((select D90 from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as D90,
	@d120:=IFNULL((select D120 from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as OverDue,
	@Long_Overdue:=IFNULL((select D150 + D180 + D210 + D240 + D270 + d300 + d330 from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as LongOverDue,
	@OpenAccTotal:=IFNULL((@CURRBAL+ @d30 + @d60 + @d90 + @d120 + @Long_Overdue),0) AS OpenAccTotal,
	@PdcTotal:=IFNULL((select pdcbal from ~#~monthenddebtors  where accnum = '~Acc num~' and date BETWEEN '~Date from~' and nextDate),0) as PdcTotal,
	IFNULL((@OpenAccTotal + @PdcTotal),0) As TotalOS,
	if(docnum='-1','',date) as Date, 
	if(docnum='-1','',docnum) AS DocNo,
	IFNULL((select dtype from doctype where num = transtype),'') as Description, 
	if(docnum='-1','',if(transam>='0',round(transam,2),'')) as Debit,
	if(transam<'0',round(transam*-1,2),'') as Credit
	
from 	~#~dtrans as dtrans where accnum = '~Acc num~'
AND	((Transtype = '7' and agent = '-') or (Transtype <> '7'))
having 	date between '~Date from~' and (select min(distinct(date(date))) from ~#~monthenddebtors where date(date) > '~Date from~')]]></queryString>

