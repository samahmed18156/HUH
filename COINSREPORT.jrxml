	<queryString><![CDATA[SELECT 
	IDATE AS IDATE, 
	DOCNUM AS DOCNUM, 
	AMOUNT AS Amount, 
	breakdown AS BREAKDOWN, 
	USER AS USER, 
	RDATE AS USED_DATE, 
	CASHIER AS CASHIER
FROM ~#~COINS
WHERE DATE(IDATE) BETWEEN '~Date from~' AND '~Date to~'
AND IF('UNUSED'='~Status~',RDATE IS NULL,IF('USED'='~Status~',RDATE IS NOT NULL,TRUE))]]></queryString>

