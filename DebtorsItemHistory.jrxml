	<queryString><![CDATA[select 
	date as Date, 
	time as Time, 
	code as Code,
	descr as Descr, 
	qty*-1 as qty, 
	price as Price, 
	round(-1*qty*price,2) as value 
from ~#~sttrans 
where accnum like '~Acc Num~' and date between '~Date from~' and '~Date to~' order by code, date]]></queryString>

