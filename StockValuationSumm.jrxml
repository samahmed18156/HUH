	<queryString><![CDATA[select 
	'SOH > 0',
	sum((soh)) as TSoh,
	sum((soh)*sp1) as TSP1,
	sum((soh)*cpe) as TCPE,
	sum((soh)*cpi) as TCPI,
	sum((soh)*acp) as TACP
from ~#~stockt2 where (soh) > '0'
union
select 
	'SOH < 0',
	sum((soh)) as TSoh,
	sum((soh)*sp1) as TSP1,
	sum((soh)*cpe) as TCPE,
	sum((soh)*cpi) as TCPI,
	sum((soh)*acp) as TACP
from ~#~stockt2 where (soh) < '0'
union
select 
	'BlkSOH > 0',
	sum(qoh) as TSoh,
	sum((qoh)*sp1) as TSP1,
	sum((qoh)*cpe) as TCPE,
	sum((qoh)*cpi) as TCPI,
	sum((qoh)*acp) as TACP
from ~#~qoh 
left join ~#~stockt2 on ~#~qoh.code=~#~stockt2.code
where (qoh) > '0'
union
select 
	'BlkSOH < 0',
	sum(qoh) as TSoh,
	sum((qoh)*sp1) as TSP1,
	sum((qoh)*cpe) as TCPE,
	sum((qoh)*cpi) as TCPI,
	sum((qoh)*acp) as TACP
from ~#~qoh 
left join ~#~stockt2 on ~#~qoh.code=~#~stockt2.code
where (qoh) < '0']]></queryString>

