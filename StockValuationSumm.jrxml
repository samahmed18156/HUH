	<field name="TSoh" class="java.lang.Double"/>
	<field name="TSP1" class="java.lang.Double"/>
	<field name="TCPE" class="java.lang.Double"/>
	<field name="TCPI" class="java.lang.Double"/>
	<field name="TACP" class="java.lang.Double"/>

	<variable name="SumTSoh" class="java.lang.Double" resetType="Report" calculation="Sum">
