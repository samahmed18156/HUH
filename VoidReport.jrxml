	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT		date, 
		time, 
		code, 
		descr, 
		qty, 
		round(price,2) AS Unit_price,
		round(qty * price,2) As Total_price,
		accnum, 
		user 
FROM 		~#~voids
WHERE 		date >= '~Date from~' and date <= '~Date to~'
AND 		user like '~User~' ]]></queryString>

	<field name="date" class="java.sql.Date"/>
	<field name="time" class="java.sql.Time"/>
	<field name="code" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="qty" class="java.lang.Double"/>
	<field name="Unit_price" class="java.lang.Double"/>
	<field name="Total_price" class="java.lang.Double"/>
	<field name="accnum" class="java.lang.String"/>
	<field name="user" class="java.lang.String"/>

	<variable name="SUM_qty_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="SUM_Total_price_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Total_price}]]></variableExpression>
	</variable>
