<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="AgentsCommissionListing"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 	(SELECT dtype FROM doctype WHERE num = ~#~dtrans.transtype) AS DOCTYPE,
	~#~dtrans.docnum, 
	~#~dtrans.accnum,
	(SELECT name FROM ~#~DEBTORS WHERE accnum = ~#~dtrans.accnum) AS ACCNAME, 
	~#~dtrans.date, 
	~#~dtrans.ref, 
	if(~#~dtrans.transtype = '4' and paytype != '5', ROUND((~#~dtrans.transAm*-1),2), ROUND((~#~dtrans.transAm),2)) AS TransAmnt, 
	~#~dtrans.vatam,
	IFNULL((SELECT SUM(PRICE*QTY*-1) FROM ~#~STTRANS WHERE ~#~STTRANS.DOCNUM = ~#~DTRANS.DOCNUM AND ~#~DTRANS.TRANSTYPE = ~#~STTRANS.TRANSTYPE AND COMM = '0'),'0') AS NOCOM,
	if(~#~dtrans.transtype = '7' ,(SELECT ROUND(AVG(comm),2) FROM ~#~sttrans WHERE docnum = ~#~dtrans.ref and code != ' '),IFNULL((SELECT ROUND(AVG(comm),2) FROM ~#~sttrans WHERE docnum = ~#~dtrans.docnum AND transtype = ~#~dtrans.transtype and code != ' ' AND COMM != '0'),'0.00')) as CommPec,
	if(~#~dtrans.transtype = '7' ,
		round((~#~dtrans.transam-~#~dtrans.vatam)*(SELECT AVG(comm/100) FROM ~#~sttrans WHERE docnum = ~#~dtrans.ref and code != ' ' AND COMM != '0'),2), 
	if(~#~dtrans.transtype = '8',round((~#~dtrans.transam-(~#~dtrans.vatam))*(SELECT AVG(comm/100) FROM ~#~sttrans WHERE docnum = ~#~dtrans.docnum and code != ' ' AND COMM != '0'),2),

round((~#~dtrans.transam-~#~dtrans.vatam-(IFNULL((SELECT SUM(PRICE*QTY*-1) FROM ~#~STTRANS WHERE ~#~STTRANS.DOCNUM = ~#~DTRANS.DOCNUM AND ~#~DTRANS.TRANSTYPE = ~#~STTRANS.TRANSTYPE AND COMM = '0'),'0')))*(SELECT AVG(comm/100) FROM ~#~sttrans WHERE docnum = ~#~dtrans.docnum and code != ' 'AND COMM != '0')*(if(~#~dtrans.transtype = '4' and paytype != '5',-1,1)),2))) AS COMM
FROM 	~#~dtrans
WHERE 	transtype IN ('0','8','4') 
AND 	DATE BETWEEN '~Date from~' AND '~Date to~'
AND 	agent = '~Agent number~']]></queryString>

	<field name="DOCTYPE" class="java.lang.String"/>
	<field name="docnum" class="java.lang.String"/>
	<field name="accnum" class="java.lang.String"/>
	<field name="ACCNAME" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
	<field name="ref" class="java.lang.String"/>
	<field name="TransAmnt" class="java.lang.Double"/>
	<field name="vatam" class="java.lang.Double"/>
	<field name="NOCOM" class="java.lang.Double"/>
	<field name="CommPec" class="java.lang.String"/>
	<field name="COMM" class="java.lang.Double"/>

	<variable name="SUM_TransAmnt_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{TransAmnt}]]></variableExpression>
	</variable>
	<variable name="SUM_vatam_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{vatam}]]></variableExpression>
	</variable>
	<variable name="SUM_COMM_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{COMM}]]></variableExpression>
	</variable>
	<variable name="SUM_NOCOM_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{NOCOM}]]></variableExpression>
	</variable>
