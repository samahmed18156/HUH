	<queryString><![CDATA[select 
	~#~stockt2.code as Code,
	~#~stockt2.descr as Description,
	~#~stockt2.cpe as Price, 
	~#~stockt2.dept as Department, 
	~#~stockt2.blksoh as SOH, 
	sum(~#~stocktake2.qty) AS Counted,
	(~#~stockt2.blksoh - sum(~#~stocktake2.qty))  as Diff,
	(~#~stockt2.blksoh - sum(~#~stocktake2.qty))*~#~stockt2.cpe  as Value
from ~#~stockt2, ~#~stocktake2 
where ~#~stockt2.code = ~#~stocktake2.code 
group by ~#~stocktake2.code order by diff desc;]]></queryString>

