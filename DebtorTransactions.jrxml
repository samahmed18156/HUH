	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 		date, 
		time, 
		(select dtype from doctype where num = transtype) as dType, 
		docnum, 
		if(transtype = 'R',transam * -1,transam) AS TRANSAm, 
		vatam, 
		(select ptype from paytype where num = paytype) as payType, 
		user 
from 		~#~dtrans 
where 		accnum = '~J~' 
and 		date >= '~K~'
order by 	date ASC, time ASC]]></queryString>

	<field name="TRANSAm" class="java.lang.Double"/>
	<field name="vatam" class="java.lang.Double"/>
	<field name="dType" class="java.lang.String"/>
	<field name="docnum" class="java.lang.String"/>
	<field name="payType" class="java.lang.String"/>
	<field name="user" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
	<field name="time" class="java.sql.Time"/>

