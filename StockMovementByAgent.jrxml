		 name="classic"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 		~#~sttrans.date As Trans_date,
		~#~sttrans.time Trans_time,
		~#~sttrans.transtype As Transtype,
		(select dtype from doctype where num = ~#~sttrans.transtype) As Doc_type,
		~#~sttrans.accnum As Accnum,
		~#~sttrans.docnum AS Docnum,
		~#~sttrans.code AS Stk_code,
		~#~sttrans.descr AS Stk_desc,
		~#~sttrans.qty * -1 AS Qty,
		~#~sttrans.price AS Price,
		(~#~sttrans.qty * -1) * ~#~sttrans.price As Amt, 
		(select name from ~#~agents where agentnum = '~Agent~') as Agent_name
		
FROM 		~#~sttrans, ~#~dtrans
WHERE 		~#~sttrans.docnum = ~#~dtrans.docnum
AND 		~#~sttrans.transtype = ~#~dtrans.transtype
AND		~#~sttrans.date BETWEEN '~Date from~' AND '~Date to~'
AND 		~#~dtrans.agent = '~Agent~'
ORDER BY 	~#~sttrans.date ASC, ~#~sttrans.time ASC]]></queryString>

	<field name="Trans_date" class="java.sql.Date"/>
	<field name="Trans_time" class="java.sql.Time"/>
	<field name="Transtype" class="java.lang.String"/>
	<field name="Doc_type" class="java.lang.String"/>
	<field name="Accnum" class="java.lang.String"/>
	<field name="Docnum" class="java.lang.String"/>
	<field name="Stk_code" class="java.lang.String"/>
	<field name="Stk_desc" class="java.lang.String"/>
	<field name="Qty" class="java.lang.Double"/>
	<field name="Price" class="java.lang.Double"/>
	<field name="Amt" class="java.lang.Double"/>
	<field name="Agent_name" class="java.lang.String"/>

	<variable name="SUM_Amt_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Amt}]]></variableExpression>
	</variable>
