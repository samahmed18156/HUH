	<queryString><![CDATA[SELECT 
	code as code, 
	descr as descr, 
	ROUND(blksoh,2) as soh, 
	ROUND(cpe,2) As UnitCostExcl, 
	ROUND(cpi,2) As UnitCostIncl, 
	ROUND((sp1),2) As SellingPrice
FROM ~#~stockt2 
WHERE blksoh ~SOH~ 
AND ~Range~ BETWEEN '~From~' AND '~To~' 
ORDER BY ~Range~ ASC, descr ASC;]]></queryString>

