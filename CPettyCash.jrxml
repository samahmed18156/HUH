	<queryString><![CDATA[SELECT
     ~#~pettycash.num AS num,
     ~#~pettycash.pdate AS date,
     ~#~pettycash.descr AS Description,
     ~#~pettycash.value AS Amount,
     ~#~pettycash.user AS User
FROM
     ~#~pettycash
where 
	~#~pettycash.closed = '1'
and
date(~#~pettycash.pdate) BETWEEN '~Date from~' AND '~Date to~';]]></queryString>

