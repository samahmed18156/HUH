<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="classic"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 
	concat(e.firstnames, ' ',e.surname) as Name, 
	@ah:=SEC_TO_TIME(sum(TIME_TO_SEC(TIMEDIFF(DayE, DayS)))) as totalActualHours ,

	@rs:=(sum(TIME_TO_SEC(if(holiday='Yes',(select TIMEDIFF(tend, tstart) from m1attendcat where scat = 'Holiday'),
		if((dayname(dt)='Saturday' or dayname(dt) = 'Sunday'),
			(select TIMEDIFF(tend, tstart) from m1attendcat where scat = dayname(dt)), # ACTUAL HR SAT OR SUN 
			(select TIMEDIFF(tend, tstart) from m1attendcat where num = '1')) # ACTUAL HR WEEKDAYS
	)))) as requiredSec,

	@rh:=SEC_TO_TIME(sum(TIME_TO_SEC(if(holiday='Yes',(select TIMEDIFF(tend, tstart) from m1attendcat where scat = 'Holiday'),
		if((dayname(dt)='Saturday' or dayname(dt) = 'Sunday'),
			(select TIMEDIFF(tend, tstart) from m1attendcat where scat = dayname(dt)), # ACTUAL HR SAT OR SUN 
			(select TIMEDIFF(tend, tstart) from m1attendcat where num = '1')) # ACTUAL HR WEEKDAYS
	)))) as requiredHours,

@dh:=TIMEDIFF(SEC_TO_TIME(sum(TIME_TO_SEC(TIMEDIFF(DayE, DayS)))), SEC_TO_TIME(sum(TIME_TO_SEC(if(holiday='Yes',(select TIMEDIFF(tend, tstart) from m1attendcat where scat = 'Holiday'),
		if((dayname(dt)='Saturday' or dayname(dt) = 'Sunday'),
			(select TIMEDIFF(tend, tstart) from m1attendcat where scat = dayname(dt)), # ACTUAL HR SAT OR SUN 
			(select TIMEDIFF(tend, tstart) from m1attendcat where num = '1')) # ACTUAL HR WEEKDAYS
	)))) ) as hourDiff ,

@dhs:=(((sum(TIME_TO_SEC(TIMEDIFF(DayE, DayS))))-(sum(TIME_TO_SEC(if(holiday='Yes',(select TIMEDIFF(tend, tstart) from m1attendcat where scat = 'Holiday'),
		if((dayname(dt)='Saturday' or dayname(dt) = 'Sunday'),
			(select TIMEDIFF(tend, tstart) from m1attendcat where scat = dayname(dt)), # ACTUAL HR SAT OR SUN 
			(select TIMEDIFF(tend, tstart) from m1attendcat where num = '1')) # ACTUAL HR WEEKDAYS
	)))) )) as hourDiffsec ,


	(SELECT concat(addr1, ', ',addr2, ', ',addr3, ' ', 'Tel: ', tel1) FROM codetails WHERE conum = 'm1') as CoAddr,	
	e.addr1 as Addr1, 
	e.addr2 as Addr2, 
	e.addr3 as Addr3, 
	e.acode as Addrpcode, 
	e.empno as Empno,
	e.idno as IDno,
	e.cell as Cellno,
	e.startdate as Startdate,
	e.gross as Gross,
	e.bonus as Comm,
	e.lpay as Leavepay,	
	e.gross as Grosspay,
	e.paye as PAYE,
	e.uif as UIF,
	e.otherDeductAmt as Totded,
	e.nett as Nett,
	a.dt as date,
	count(distinct dt) as totalDays,
	count(dayE) as daysWorked 
from m1attendempmast as e, m1attend as a
where e.userID = a.username
and e.payFreq = 'MONTHLY'
and e.userID like '%' and dt between  '~Date from~' and '~Date to~'
group by name]]></queryString>

	<field name="Name" class="java.lang.String"/>
	<field name="totalActualHours" class="java.lang.String"/>
	<field name="requiredSec" class="java.lang.Double"/>
	<field name="requiredHours" class="java.lang.String"/>
	<field name="hourDiff" class="java.lang.String"/>
	<field name="hourDiffsec" class="java.lang.Double"/>
	<field name="CoAddr" class="java.lang.String"/>
	<field name="Addr1" class="java.lang.String"/>
	<field name="Addr2" class="java.lang.String"/>
	<field name="Addr3" class="java.lang.String"/>
	<field name="Addrpcode" class="java.lang.String"/>
	<field name="Empno" class="java.lang.String"/>
	<field name="IDno" class="java.lang.String"/>
	<field name="Cellno" class="java.lang.String"/>
	<field name="Startdate" class="java.lang.String"/>
	<field name="Gross" class="java.lang.Double"/>
	<field name="Comm" class="java.lang.Double"/>
	<field name="Leavepay" class="java.lang.Double"/>
	<field name="Grosspay" class="java.lang.Double"/>
	<field name="PAYE" class="java.lang.Double"/>
	<field name="UIF" class="java.lang.Double"/>
	<field name="Totded" class="java.lang.Double"/>
	<field name="Nett" class="java.lang.Double"/>
	<field name="date" class="java.sql.Date"/>
	<field name="totalDays" class="java.lang.Integer"/>
	<field name="daysWorked" class="java.lang.Integer"/>

	<variable name="TEarn" class="java.lang.Double" resetType="Page" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double( ( $F{Gross}.doubleValue() + $F{Leavepay}.doubleValue() + $F{Comm}.doubleValue() ))]]></variableExpression>
	</variable>
	<variable name="TDeduct" class="java.lang.Double" resetType="Page" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Gross}.doubleValue() / 100) + ($F{PAYE}.doubleValue()  ))]]></variableExpression>
	</variable>
	<variable name="NetPay" class="java.lang.Double" resetType="Page" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{TEarn}.doubleValue()) - ($V{TDeduct}.doubleValue()) )]]></variableExpression>
	</variable>
	<variable name="ratePerHr" class="java.lang.Double" resetType="Page" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($F{Gross}.doubleValue()) /($F{requiredSec}.doubleValue()/60/60) )]]></variableExpression>
	</variable>
	<variable name="RLossGain" class="java.lang.Double" resetType="Page" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  ($V{ratePerHr}.doubleValue()) *(($F{hourDiffsec}.doubleValue())/60/60) )]]></variableExpression>
	</variable>
	<variable name="daysAbsent" class="java.lang.Integer" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Integer(  ($F{totalDays}.intValue()) -($F{daysWorked}.intValue()) )]]></variableExpression>
	</variable>

