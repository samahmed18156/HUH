<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="StockMovement"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
		@Opening:=(SELECT soh from ~#~monthendstock where code = '~Code~') AS Opening,
		CONCAT_WS(' ',~#~sttrans.date,~#~sttrans.time) AS Date,
		~#~sttrans.date AS Display_date,
		~#~sttrans.time AS Display_time,
		~#~sttrans.docnum AS Docnum,
		~#~sttrans.accnum AS Accnum,
		IF(~#~sttrans.transtype = '0','Invoice', 
		IF(~#~sttrans.transtype = '1','Credit note',
		IF(~#~sttrans.transtype = '2','Jrnl Cr',
		IF(~#~sttrans.transtype = '3','Jrnl Dr',
		IF(~#~sttrans.transtype = '4','Laybye',
		IF(~#~sttrans.transtype = '5','Receipt',
		IF(~#~sttrans.transtype = '6','GRN',
		IF(~#~sttrans.transtype = '7','Disc',
		IF(~#~sttrans.transtype = '8','Cr. Note','Dr. Note'))))))))) As Transtype,
		@LineQty:= ~#~sttrans.qty AS Qty,
		@CurQty:= @Opening + @LineQty AS CurQty
FROM 		~#~sttrans, ~#~monthendstock  
WHERE 		~#~sttrans.code = ~#~monthendstock.Code
AND		~#~sttrans.code = '~Code~'
AND 		CONCAT_WS(' ',~#~sttrans.date,~#~sttrans.time) > (SELECT date FROM ~#~monthendstock WHERE code = '~Code~')
ORDER BY 	Date ASC;]]></queryString>

	<field name="Opening" class="java.lang.Double"/>
	<field name="Date" class="java.lang.String"/>
	<field name="Display_date" class="java.sql.Date"/>
	<field name="Display_time" class="java.sql.Time"/>
	<field name="Docnum" class="java.lang.String"/>
	<field name="Transtype" class="java.lang.String"/>
	<field name="Qty" class="java.lang.Double"/>
	<field name="CurQty" class="java.lang.Double"/>
	<field name="Accnum" class="java.lang.String"/>

	<variable name="SUM_Qty_1" class="java.lang.Double" resetType="Report" calculation="Sum">
