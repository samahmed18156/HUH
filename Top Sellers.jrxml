<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Top Sellers"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="842"
		 pageHeight="595"
		 columnWidth="782"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT		~#~sttrans.code as Code, ~#~stockt2.descr as Description, dept, SUM(~#~sttrans.QTY*-1) as Qty,  
		~#~stockt2.soh as SOH , round((cpe * sum(~#~sttrans.qty*-1)),2) as Cost, 
		round((~#~stockt2.sp1 * sum(~#~sttrans.qty*-1) / 1.14),2) as SPrice 
FROM 		~#~sttrans, ~#~stockt2 
WHERE 		~#~sttrans.date BETWEEN '~Date from~' AND '~Date to~' 
AND		~#~sttrans.code = ~#~stockt2.code 
AND 		transtype = '0' 
GROUP BY 	code 
ORDER BY 	Qty DESC LIMIT 0,~Quantity~;]]></queryString>

	<field name="Code" class="java.lang.String"/>
	<field name="Description" class="java.lang.String"/>
	<field name="Qty" class="java.math.BigDecimal"/>
	<field name="SOH" class="java.lang.Integer"/>
	<field name="Cost" class="java.lang.Double"/>
	<field name="SPrice" class="java.lang.Double"/>
	<field name="dept" class="java.lang.String"/>

	<variable name="SUM_Qty_1" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Qty}]]></variableExpression>
	</variable>
	<variable name="SUM_SOH_1" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SOH}]]></variableExpression>
	</variable>
	<variable name="SUM_Cost_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{Cost}]]></variableExpression>
	</variable>
	<variable name="SUM_SPrice_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{SPrice}]]></variableExpression>
	</variable>
	<variable name="GP" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new java.lang.Double(  (($V{SUM_SPrice_1}.doubleValue()) -($V{SUM_Cost_1}.doubleValue()))/($V{SUM_SPrice_1}.doubleValue())*100 )]]></variableExpression>
	</variable>
