	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[select 'CREDITORS' as DESCR ,sum(osbal) as AMOUNT from ~#~creditors where ctype = 'supplier'
union
select 'DEBTORS',sum(osbal) from ~#~debtors
union
select 'SALES',round(sum(if(transtype='4' and paytype!='5',transam*-1,transam)),2) from ~#~dtrans where transtype in ('0','4','8') and date between '~Date from~' and '~Date to~'
union
select 'PURCHASES',sum(transam) from ~#~ctrans where transtype in ('6','9') and date between '~Date from~' and '~Date to~' and accnum in (select accnum from ~#~creditors where ctype = 'supplier')
union
select 'DISC REC',sum(transam*-1) from ~#~ctrans where transtype = '7' and date between '~Date from~' and '~Date to~'
union
select 'DISC ISSUED',sum(transam*-1) from ~#~dtrans where transtype = '7' and date between '~Date from~' and '~Date to~' and agent = '-'
union
select num, amount+ifnull((SELECT sum(TRANSAM*-1) as amount FROM ~#~DTRANS WHERE TRANSTYPE IN ('5') AND REF LIKE concat(num,'%')),0)+ifnull((SELECT sum(TRANSAM) as amount FROM ~#~cTRANS WHERE TRANSTYPE IN ('5') AND REF LIKE concat(num,'%')),0) as amount from ~#~bank 
union
select  (select name from ~#~creditors where ~#~creditors.accnum = ~#~ctrans.accnum) as name, sum(transam) as tvalue
from ~#~ctrans 
where transType in ('6','9') and 
accnum in (select accnum from ~#~creditors where ctype = 'expense')
and date between '~Date from~' and '~Date to~'
group by accnum
union
select name,osbal from ~#~creditors where ctype = 'asset' and osbal != '0']]></queryString>

