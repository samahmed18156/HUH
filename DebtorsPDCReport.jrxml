	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT 
	~#~debtors.accnum as accnum, 
	~#~debtors.name as name , 
	~#~pdc.PDCNum as pdcnum, 
	DATE(~#~pdc.DueDate) as duedate, 
	DATE(~#~pdc.Capture) as capdate, 
	~#~pdc.Amount as amount, 
	~#~pdc.Cheque as cheque
 FROM ~#~debtors, ~#~pdc
 WHERE ~#~debtors.accnum = ~#~pdc.AccNum
 AND ~#~pdc.PDCMet like 'n%'
AND ~#~debtors.accnum BETWEEN '~Debtors from~' AND '~Debtors to~'  
ORDER BY ~#~debtors.accnum ASC;]]></queryString>

