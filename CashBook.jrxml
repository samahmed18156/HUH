	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT DATE as date, TIME as time, ACCNUM as accnum, 
(SELECT NAME FROM ~#~DEBTORS WHERE ACCNUM = ~#~DTRANS.ACCNUM) AS name, TRANSAM*-1 as amount, 
(select amount from ~#~bank where num = '~ACC~' and tdate  = '~Date~') as bal
,DATE_FORMAT(date,'%M %Y') as mt, docnum, ref
FROM ~#~DTRANS WHERE TRANSTYPE IN ('5') AND REF LIKE '~ACC~%' and concat(date,' ',time) >= '~Date~'
union
SELECT DATE, TIME, ACCNUM, (SELECT NAME FROM ~#~creditors WHERE ACCNUM = ~#~cTRANS.ACCNUM) AS NAME, TRANSAM,
(select amount from ~#~bank where num = '~ACC~' and tdate  = '~Date~') as bal 
,DATE_FORMAT(date,'%M %Y') as mt, docnum, ref
FROM ~#~CTRANS WHERE TRANSTYPE IN ('5') AND REF LIKE '~ACC~%' and concat(date,' ',time) >= '~Date~'
ORDER BY DATE, TIME ASC;]]></queryString>

	<field name="date" class="java.sql.Date"/>
	<field name="time" class="java.sql.Time"/>
	<field name="accnum" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<field name="bal" class="java.lang.Double"/>
	<field name="mt" class="java.lang.String"/>
	<field name="docnum" class="java.lang.String"/>
	<field name="ref" class="java.lang.String"/>

	<variable name="total" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="MnthTotal" class="java.lang.Double" resetType="Group" resetGroup="Month" calculation="Sum">
